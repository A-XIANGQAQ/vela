From 45689b3e0e8e3580a58e349c4dd273cf8e79417a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 24 Nov 2026 23:35:01 +0100
Subject: [PATCH 63/65] round 6: FFXFeature_Vk three-way merge (upstream
 _ffx/CustomFfxModule, DittoSR module as _ffx), FeatureProvider_Vk chain on
 upstream backend ref, RCAS Vk shader regenerated from rcas.hlsl (upstream +
 0048)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 OptiScaler/proxies/FfxApi_Proxy.h             |   14 +
 .../shaders/rcas/precompile/RCAS_Shader_Vk.h  | 1344 +++++++++--------
 .../rcas/precompile/RCAS_Shader_Vk.spv        |  Bin 8764 -> 8932 bytes
 OptiScaler/upscalers/FeatureProvider_Vk.cpp   |   30 +-
 OptiScaler/upscalers/ffx/FFXFeature_Vk.cpp    |  152 +-
 OptiScaler/upscalers/ffx/FFXFeature_Vk.h      |   30 +-
 6 files changed, 791 insertions(+), 779 deletions(-)

diff --git a/OptiScaler/proxies/FfxApi_Proxy.h b/OptiScaler/proxies/FfxApi_Proxy.h
index 8ca18617..33abe7e2 100644
--- a/OptiScaler/proxies/FfxApi_Proxy.h
+++ b/OptiScaler/proxies/FfxApi_Proxy.h
@@ -1570,6 +1570,12 @@ class FfxApiProxy
         if (context != nullptr && dittosrContexts.contains(*context)) // Vela 0036
             return dittosr_dx12.Configure(context, desc);
 
+        if (FSR4DriverProviderDx12::OwnsContext(context))
+            return FSR4DriverProviderDx12::Configure(context, desc);
+
+        if (auto custom = CustomContextModule(context))
+            return custom->Configure(context, desc);
+
         auto type = GetType(desc->type);
 
         if (type == FFXStructType::General && contextToType.contains(*context))
@@ -1826,6 +1832,12 @@ class FfxApiProxy
         if (context != nullptr && dittosrContexts.contains(*context)) // Vela 0036
             return dittosr_dx12.Dispatch(context, desc);
 
+        if (FSR4DriverProviderDx12::OwnsContext(context))
+            return FSR4DriverProviderDx12::Dispatch(context, desc);
+
+        if (auto custom = CustomContextModule(context))
+            return custom->Dispatch(context, desc);
+
         auto type = GetType(desc->type);
         auto isFg = type == FFXStructType::FG || type == FFXStructType::SwapchainDX12;
 
@@ -1966,6 +1978,8 @@ class FfxApiProxy
     // as amd_fidelityfx_upscaler_vk.dll, then as amd_fidelityfx_upscaler_dx12.dll (neither name is one OptiScaler's load
     // hooks or AMD's Vulkan module answer to: AMD's is amd_fidelityfx_vk.dll). Loaded once, lazily, never hooked; the
     // Vulkan feature calls its exports directly (FFXFeature_Vk.cpp), so fsr3 keeps AMD's FSR 3.1 module.
+    // `_ffx` of an FFXFeatureVk whose live model is dittosr (Vela 0040)
+    static FfxModule* DittoSRVk_Module() { return &dittosr_vk; }
     static std::wstring DittoSRVk_Path() { return dittosr_vk.filePath; }
     static const std::string& DittoSRVk_Why() { return dittosrVkWhy; }
     static PfnFfxCreateContext DittoSRVk_CreateContext() { return dittosr_vk.CreateContext; }
