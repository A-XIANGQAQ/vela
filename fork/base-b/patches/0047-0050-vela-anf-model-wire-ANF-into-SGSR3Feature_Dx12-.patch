@@ -708,6 +717,37 @@ bool SGSR3FeatureDx12::EvaluateFsr4(ID3D12GraphicsCommandList* cl, NVSDK_NGX_Par
     return true;
 }
 
+// anf1: ANF (AnfVkBridge.h): same inputs as FSR 4, own passes + the NPU layer
+bool SGSR3FeatureDx12::EvaluateAnf(ID3D12GraphicsCommandList* cl, NVSDK_NGX_Parameter* p, ID3D12Resource* color, ID3D12Resource* depth,
+                                   ID3D12Resource* mv, ID3D12Resource* output)
+{
+    AnfVkBridge::Frame f;
+    p->Get(NVSDK_NGX_Parameter_Jitter_Offset_X, &f.jitterX);
+    p->Get(NVSDK_NGX_Parameter_Jitter_Offset_Y, &f.jitterY);
+    if (p->Get(NVSDK_NGX_Parameter_MV_Scale_X, &f.mvScaleX) != NVSDK_NGX_Result_Success ||
+        p->Get(NVSDK_NGX_Parameter_MV_Scale_Y, &f.mvScaleY) != NVSDK_NGX_Result_Success)
+        f.mvScaleX = f.mvScaleY = 1.0f;
+    int reset = 0;
+    p->Get(NVSDK_NGX_Parameter_Reset, &reset);
+    f.reset = reset != 0 || _constants.reset != 0.0f;
+    constexpr auto SRV = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    constexpr auto UAV = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    if (depth == nullptr)
+    {
+        if (!_loggedVkFail)
+            LOG_WARN("SGSR3: no depth buffer on this frame; ANF skipped on this context");
+        return false;
+    }
+    if (!_anf.Evaluate(cl, { color, SRV }, { depth, SRV }, { mv, SRV }, { output, UAV }, f))
+    {
+        LOG_ERROR("SGSR3: ANF frame failed; SGSR 2 from the next frame");
+        VelaLive::Fsr4Failed() = true;
+        _anf.Release();
+        return false;
+    }
+    return true;
+}
+
 // 0039: the far plane in the game's convention (0 when inverted; the bridge flips a non-inverted depth, so 1 -> 0 there
 // too). The texture stays in NON_PIXEL_SHADER_RESOURCE after its clear.
 ID3D12Resource* SGSR3FeatureDx12::FlatDepth(ID3D12GraphicsCommandList* cl)
@@ -1217,7 +1257,9 @@ bool SGSR3FeatureDx12::EvaluateInternal(ID3D12GraphicsCommandList* InCommandList
             if (_timingEnabled)
                 InCommandList->EndQuery(_timestampHeap, D3D12_QUERY_TYPE_TIMESTAMP,
                                         _ringIndex * TimestampsPerFrame + 2);
-            const bool ok = _fsr4.Ready() && _fsr4.SizesMatch(rwNow, rhNow, dwNow, dhNow)
+            const bool ok = _anf.Ready() && _anf.SizesMatch(rwNow, rhNow, dwNow, dhNow)
+                ? EvaluateAnf(InCommandList, InParameters, paramColor, useDepth ? paramDepth : nullptr, paramVelocity, paramOutput)
+                : _fsr4.Ready() && _fsr4.SizesMatch(rwNow, rhNow, dwNow, dhNow)
                 ? EvaluateFsr4(InCommandList, InParameters, paramColor, useDepth ? paramDepth : nullptr, paramVelocity,
                                paramOutput)
                 : _student.Evaluate(
