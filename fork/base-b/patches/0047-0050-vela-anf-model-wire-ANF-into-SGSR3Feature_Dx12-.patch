 .../upscalers/sgsr3/SGSR3Feature_Dx12.cpp     | 44 ++++++++++++++++++-
 1 file changed, 43 insertions(+), 1 deletion(-)

diff --git a/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx12.cpp b/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx12.cpp
index 331e978e..a1423f58 100644
--- a/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx12.cpp
+++ b/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx12.cpp
@@ -324,6 +324,15 @@ bool SGSR3FeatureDx12::CreatePipelines(ID3D12Device* device)
                 Fsr4VkBridge::NpuShown() = true;
             }
         }
+        else if (lm == VelaLive::Model::Anf)
+        {
+            if (!_anf.Init(device, RenderWidth(), RenderHeight(), TargetWidth(), TargetHeight(), DepthInverted(), IsHdr(), LowResMV(),
+                           JitteredMV()))
