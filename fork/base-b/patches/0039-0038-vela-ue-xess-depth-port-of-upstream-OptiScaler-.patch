+// Start of the x64 function containing address, the first chunk of a split function, from the module's own exception
+// directory (the game is x64; RtlLookupFunctionEntry from ARM64EC code is not relied on)
+uintptr_t GetFunctionStart(HMODULE module, uintptr_t address)
+{
+    struct X64RuntimeFunction
+    {
+        DWORD begin;
+        DWORD end;
+        DWORD unwind;
+    };
+
+    auto base = (uint8_t*) module;
+    auto dos = (IMAGE_DOS_HEADER*) base;
+    auto nt = (IMAGE_NT_HEADERS64*) (base + dos->e_lfanew);
+
+    if (nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC ||
+        nt->OptionalHeader.NumberOfRvaAndSizes <= IMAGE_DIRECTORY_ENTRY_EXCEPTION)
+    {
+        return 0;
     }
-    __except (EXCEPTION_EXECUTE_HANDLER)
+
+    auto& dir = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXCEPTION];
+    auto functions = (const X64RuntimeFunction*) (base + dir.VirtualAddress);
+    size_t count = dir.Size / sizeof(X64RuntimeFunction);
+    auto rva = (DWORD) (address - (uintptr_t) base);
+
+    size_t low = 0;
+    size_t high = count;
+    const X64RuntimeFunction* function = nullptr;
+
+    while (low < high)
     {
-        return false;
+        auto mid = (low + high) / 2;
+
+        if (rva < functions[mid].begin)
+            high = mid;
+        else if (rva >= functions[mid].end)
+            low = mid + 1;
+        else
+        {
+            function = &functions[mid];
+            break;
+        }
+    }
+
+    // UNWIND_INFO: version and flags, prolog size, code count, frame; UNW_FLAG_CHAININFO (4) puts the parent function's
+    // RUNTIME_FUNCTION after the (even padded) unwind codes
+    for (int depth = 0; function != nullptr && depth < 32; depth++)
+    {
+        auto unwind = base + (function->unwind & ~1u);
+
+        if ((unwind[0] >> 3) & 4)
+        {
+            auto codes = (unwind[2] + 1) & ~1;
+            function = (const X64RuntimeFunction*) (unwind + 4 + codes * 2);
+            continue;
+        }
+
+        return (uintptr_t) base + function->begin;
     }
+
+    return 0;
 }
 
