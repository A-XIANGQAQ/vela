-// Engine memory can already be freed and reused
+// Vela: the committed, readable region a read was last checked in. Reset at the start of every probe, so a region the
+// engine released since cannot be taken from the cache
+thread_local uintptr_t t_readableBase = 0;
+thread_local uintptr_t t_readableEnd = 0;
+
+void ResetReadCache() { t_readableBase = t_readableEnd = 0; }
+
+bool IsReadable(uintptr_t address, size_t size)
+{
+    for (int region = 0; region < 4 && size != 0; region++)
+    {
+        if (address < t_readableBase || address >= t_readableEnd)
+        {
+            MEMORY_BASIC_INFORMATION mbi {};
+
+            if (VirtualQuery((LPCVOID) address, &mbi, sizeof(mbi)) == 0 || mbi.State != MEM_COMMIT ||
+                (mbi.Protect & (PAGE_GUARD | PAGE_NOACCESS)) != 0 || (mbi.Protect & 0xFF) == PAGE_EXECUTE ||
+                mbi.Protect == 0)
+            {
+                return false;
+            }
+
+            t_readableBase = (uintptr_t) mbi.BaseAddress;
+            t_readableEnd = t_readableBase + mbi.RegionSize;
+        }
+
+        auto inRegion = std::min<size_t>(size, t_readableEnd - address);
+        address += inRegion;
+        size -= inRegion;
+    }
+
+    return size == 0;
+}
