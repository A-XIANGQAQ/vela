+        for (auto p = section.start; p + 7 <= section.end; p++)
+        {
+            if ((p[0] != 0x48 && p[0] != 0x4C) || p[1] != 0x8D || (p[2] & 0xC7) != 0x05)
+                continue;
+
+            if (reinterpret_cast<uintptr_t>(p + 7) + *reinterpret_cast<int32_t*>(p + 3) == target)
+                return reinterpret_cast<uintptr_t>(p);
+        }
+    }
+
+    return 0;
