     case Upscaler::SGSR3:
         return "SGSR 3";
 
+    case Upscaler::SGSR2_on12:
+        return "SGSR 2 w/Dx12";
+
+    case Upscaler::SGSR3_on12:
+        return "SGSR 3 w/Dx12";
+
     case Upscaler::FFX:
         // Native Vulkan gets FSR 4 from the driver
         if (fsr4Capable && (api == API::DX12 || api == API::Vulkan))
@@ -133,6 +139,7 @@ std::string UpscalerShortName(Upscaler upscaler)
     case Upscaler::SGSR2:
