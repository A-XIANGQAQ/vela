@@ -1,5 +1,6 @@
 #include <pch.h>
 #include "sgsr2/SGSR2Feature_Dx11on12.h"
+#include "sgsr3/SGSR3Feature_Dx11on12.h"
 #include "FeatureProvider_Dx11.h"
 
 #include "Util.h"
@@ -42,6 +43,10 @@ bool FeatureProvider_Dx11::GetFeature(Upscaler upscaler, UINT handleId, NVSDK_NG
         *feature = std::make_unique<SGSR2FeatureDx11on12>(handleId, parameters);
         break;
 
+    case Upscaler::SGSR3_on12:
+        *feature = std::make_unique<SGSR3FeatureDx11on12>(handleId, parameters);
+        break;
+
     case Upscaler::XeSS_on12:
         *feature = std::make_unique<XeSSFeatureDx11on12>(handleId, parameters);
         break;
@@ -261,9 +266,16 @@ bool FeatureProvider_Dx11::ChangeFeature(Upscaler upscaler, ID3D11Device* device
 
             if (state.newBackend != Upscaler::DLSSD)
             {
-                state.newBackend = Upscaler::FSR22;
+                // Vela 0027: on Adreno a DX11 backend that cannot start goes to SGSR 2 over the bridge (FSR 2.2 when
+                // SGSR 2 itself failed)
+                const bool toSgsr2 =
+                    IsAdrenoGpu(IdentifyGpu::getPrimaryGpu()) && state.newBackend != Upscaler::SGSR2_on12;
+                LOG_WARN("Vela live: {0} did not start; {1} instead", UpscalerDisplayName(state.newBackend),
+                         toSgsr2 ? "SGSR 2" : "FSR 2.2");
+                state.newBackend = toSgsr2 ? Upscaler::SGSR2_on12 : Upscaler::FSR22;
                 state.changeBackend[handleId] = true;
-                ImGui::InsertNotification({ ImGuiToastType::Warning, 10000, "Falling back to FSR 2.2" });
+                ImGui::InsertNotification(
+                    { ImGuiToastType::Warning, 10000, toSgsr2 ? "Falling back to SGSR 2" : "Falling back to FSR 2.2" });
             }
             else
             {
diff --git a/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx11on12.cpp b/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx11on12.cpp
new file mode 100644
index 00000000..035a0855
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx11on12.cpp
@@ -0,0 +1,11 @@
+#include <pch.h>
+
+#include "SGSR3Feature_Dx11on12.h"
+#include "SGSR3Feature_Dx12.h"
+
+SGSR3FeatureDx11on12::SGSR3FeatureDx11on12(unsigned int InHandleId, NVSDK_NGX_Parameter* InParameters)
+    : IFeature_Dx11wDx12(InHandleId, InParameters), IFeature_Dx11(InHandleId, InParameters),
+      IFeature(InHandleId, InParameters)
