+    dx12Feature = std::make_unique<SGSR3FeatureDx12>(InHandleId, InParameters);
+}
diff --git a/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx11on12.h b/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx11on12.h
new file mode 100644
index 00000000..f674b332
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx11on12.h
@@ -0,0 +1,13 @@
+#pragma once
+#include <upscalers/IFeature_Dx11wDx12.h>
+
+// Vela patch 0027: SGSR 3 (with its FSR 4 VK bridge, FSR 4 Fast and the NPU path) driven from a D3D11 game. Like
+// SGSR2FeatureDx11on12: the bridge shares the game's D3D11 colour, depth, motion vectors and output into D3D12, the
+// ordinary SGSR3FeatureDx12 evaluates, and the bridge copies the result back to the game's D3D11 output.
+class SGSR3FeatureDx11on12 : public IFeature_Dx11wDx12
+{
+  public:
+    Upscaler GetUpscalerType() const final { return Upscaler::SGSR3_on12; }
+
+    SGSR3FeatureDx11on12(unsigned int InHandleId, NVSDK_NGX_Parameter* InParameters);
+};
