diff --git a/OptiScaler/OptiTypes.h b/OptiScaler/OptiTypes.h
index 189d313f..a7f96018 100644
--- a/OptiScaler/OptiTypes.h
+++ b/OptiScaler/OptiTypes.h
@@ -74,7 +74,8 @@ enum class Upscaler
     SGSR2, // "sgsr2", Snapdragon Game Super Resolution 2; shader-only, no vendor runtime to link
     SGSR2_on12, // "sgsr2_12", the same backend driven from DX11 through the DX12 bridge
 
-    SGSR3, // "sgsr3", SGSR 3 v0: SGSR 2 + input contract, masks, Catmull-Rom history; DX12 only
+    SGSR3, // "sgsr3", SGSR 3 v0: SGSR 2 + input contract, masks, Catmull-Rom history (with Vela's FSR 4 VK bridge)
