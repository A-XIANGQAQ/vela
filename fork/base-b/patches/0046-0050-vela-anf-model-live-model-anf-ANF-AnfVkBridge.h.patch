diff --git a/OptiScaler/upscalers/sgsr3/AnfVkBridge.h b/OptiScaler/upscalers/sgsr3/AnfVkBridge.h
new file mode 100644
index 00000000..1a525f41
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr3/AnfVkBridge.h
@@ -0,0 +1,833 @@
+#pragma once
+// ANF (Adreno Neural Fusion) as a Vela model (live model "anf", anf1 first path). Our own small NPU upscaler: two GPU compute
+// passes (ANF/impl/shaders: anf_pre -> NPU graph -> anf_post) on vkd3d-proton's VkDevice through the same interop as
+// Fsr4VkBridge; the NPU side is the layer's marker protocol (vela_npu_abi.h / vela_npu_ext.h, zero-copy BDA, F_GRAPH family name,
+// F_PHASE) in the game's command buffer. Design: ANF/DESIGN.md, plan: ANF/IMPL2.md.
+// First path: output exactly 2x the render size (no resample pass yet), RGBA16F output, low-res non-jittered MVs.
+// While the NPU is not up (PROBE in flight, family loading, no layer/daemon) the same passes run on a zero network output
+// (alpha 0, offset 0 = plain upscale of the LR colour): a visible, harmless stand-in until the family answers.
+#include <Config.h>
+#include <Util.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <string>
+#include <vector>
+
+#include "AnfSpv.h"
+#include "vela_npu_abi.h"
+#include "vela_npu_ext.h"
+
+class AnfVkBridge
+{
+  public:
+    struct Tex
+    {
+        ID3D12Resource* res = nullptr;
+        D3D12_RESOURCE_STATES state = D3D12_RESOURCE_STATE_COMMON;
+    };
+    struct Frame
+    {
+        float jitterX = 0, jitterY = 0, mvScaleX = 1, mvScaleY = 1;
+        bool reset = false;
+    };
+
+    // canvas = smallest NPU family canvas that covers the render size (ANF/IMPL1.md section 1)
+    static bool PickCanvas(uint32_t rw, uint32_t rh, uint32_t& cw, uint32_t& ch)
+    {
+        static const uint32_t C[5][2] = { { 640, 360 }, { 854, 480 }, { 960, 540 }, { 1152, 648 }, { 1280, 720 } };
+        for (auto& c : C)
+            if (rw <= c[0] && rh <= c[1])
+            {
+                cw = c[0];
+                ch = c[1];
+                return true;
+            }
+        return false;
+    }
+
+    bool Init(ID3D12Device* device, uint32_t rw, uint32_t rh, uint32_t dw, uint32_t dh, bool depthInverted, bool hdr,
+              bool lowResMv, bool jitteredMv)
+    {
+        Release();
+        _rw = rw;
+        _rh = rh;
+        _dw = dw;
+        _dh = dh;
+        _depthInverted = depthInverted;
+        if (dw != 2 * rw || dh != 2 * rh)
+        {
+            LOG_WARN("Vela ANF: output {}x{} is not 2 x render {}x{} (the resample pass is not wired yet)", dw, dh, rw, rh);
+            return false;
+        }
+        if (!lowResMv || jitteredMv)
+        {
+            LOG_WARN("Vela ANF: needs render-size, non-jittered motion vectors (low-res {}, jittered {})", lowResMv, jitteredMv);
+            return false;
+        }
+        if (!PickCanvas(rw, rh, _cw, _ch))
+        {
+            LOG_WARN("Vela ANF: render {}x{} is larger than the largest family canvas (1280x720)", rw, rh);
+            return false;
+        }
+        _family = "anf" + std::to_string(_ch) + "s32";
+        if (FAILED(device->QueryInterface(__uuidof(ID3D12DXVKInteropDevice1), (void**) &_interop)) || !_interop)
+        {
+            LOG_ERROR("Vela ANF: no vkd3d-proton interop");
+            return false;
+        }
+        VkInstance inst = VK_NULL_HANDLE;
+        if (FAILED(_interop->GetVulkanHandles(&inst, &_physical, &_vk)) || _vk == VK_NULL_HANDLE)
+        {
+            LOG_ERROR("Vela ANF: GetVulkanHandles failed");
+            return false;
+        }
+        if (!MakeFlush(device) || !MakeGpu())
+            return false;
+        _hdr = hdr;
+        LOG_INFO("Vela ANF: ready, render {}x{} -> {}x{}, canvas {}x{}, family {} (NPU after the layer's PROBE; plain upscale until then)",
+                 rw, rh, dw, dh, _cw, _ch, _family);
+        _ready = true;
+        return true;
+    }
+
+    bool Ready() const { return _ready; }
+    bool SizesMatch(uint32_t rw, uint32_t rh, uint32_t dw, uint32_t dh) const
+    {
+        return rw == _rw && rh == _rh && dw == _dw && dh == _dh;
+    }
+
+    bool Evaluate(ID3D12GraphicsCommandList* cl, const Tex& color, const Tex& depth, const Tex& mv, const Tex& output,
+                  const Frame& f)
+    {
+        if (!_ready || !color.res || !depth.res || !mv.res || !output.res)
+            return false;
+        Img in[3], out;
+        if (!Get(color, in[0], false) || !Get(depth, in[1], true) || !Get(mv, in[2], false) || !Get(output, out, false))
+            return false;
+        if (out.fmt != VK_FORMAT_R16G16B16A16_SFLOAT)
+        {
+            if (_failLogged++ < 3)
+                LOG_ERROR("Vela ANF: output VkFormat {} (only RGBA16F in this first path)", (int) out.fmt);
+            return false;
+        }
+        VkImageView vc = View(in[0], false), vd = View(in[1], true), vm = View(in[2], false), vo = View(out, false);
+        if (!vc || !vd || !vm || !vo)
+        {
+            if (_failLogged++ < 3)
+                LOG_ERROR("Vela ANF: unsupported format (colour {}, depth {}, mv {}, output {})", (int) in[0].fmt, (int) in[1].fmt,
+                          (int) in[2].fmt, (int) out.fmt);
+            return false;
+        }
+        cl->CopyBufferRegion(_flush[1], 0, _flush[0], 0, 4);
+        VkCommandBuffer cb = VK_NULL_HANDLE;
+        if (FAILED(_interop->BeginVkCommandBufferInterop(cl, &cb)) || cb == VK_NULL_HANDLE)
+        {
+            LOG_ERROR("Vela ANF: BeginVkCommandBufferInterop failed");
+            return false;
+        }
+        Transition(cb, in, 3, out, true);
+        Record(cb, vc, vd, vm, vo, f);
+        Transition(cb, in, 3, out, false);
+        _interop->EndVkCommandBufferInterop(cl);
+        HandHeapsBack(cl);
+        ++_frames;
+        return true;
+    }
+
+    void Release()
+    {
+        if (_vk && _interop)
+            vkDeviceWaitIdle(_vk);
+        if (_vk)
+        {
+            for (auto& r : _retire)
+                vkDestroyImageView(_vk, r.second, nullptr);
+            _retire.clear();
+            if (_frames > 0 || _kicks > 0)
+                Stats();
+            if (_prePipe)
+                vkDestroyPipeline(_vk, _prePipe, nullptr);
+            if (_postPipe)
+                vkDestroyPipeline(_vk, _postPipe, nullptr);
+            if (_preLayout)
+                vkDestroyPipelineLayout(_vk, _preLayout, nullptr);
+            if (_postLayout)
+                vkDestroyPipelineLayout(_vk, _postLayout, nullptr);
+            if (_preDsl)
+                vkDestroyDescriptorSetLayout(_vk, _preDsl, nullptr);
+            if (_postDsl)
+                vkDestroyDescriptorSetLayout(_vk, _postDsl, nullptr);
+            if (_pool)
+                vkDestroyDescriptorPool(_vk, _pool, nullptr);
+            for (Own* im : { &_hist[0], &_hist[1], &_feat[0], &_feat[1], &_colLR, &_mvLR })
+                if (im->img)
+                {
+                    vkDestroyImageView(_vk, im->view, nullptr);
+                    vkDestroyImage(_vk, im->img, nullptr);
+                    vkFreeMemory(_vk, im->mem, nullptr);
+                    *im = Own {};
+                }
+            for (Buf* b : { &_dummy, &_markers })
+                if (b->buf)
+                {
+                    vkDestroyBuffer(_vk, b->buf, nullptr);
+                    vkFreeMemory(_vk, b->mem, nullptr);
+                    *b = Buf {};
+                }
+            if (_dimg)
+                vkDestroyImage(_vk, _dimg, nullptr);
+            if (_dmem)
+                vkFreeMemory(_vk, _dmem, nullptr);
+        }
+        _prePipe = _postPipe = VK_NULL_HANDLE;
+        _preLayout = _postLayout = VK_NULL_HANDLE;
+        _preDsl = _postDsl = VK_NULL_HANDLE;
+        _pool = VK_NULL_HANDLE;
+        _dimg = VK_NULL_HANDLE;
+        _dmem = VK_NULL_HANDLE;
+        for (auto*& b : _flush)
+            if (b)
+            {
+                b->Release();
+                b = nullptr;
+            }
+        for (auto*& h : _dummyHeap)
+            if (h)
+            {
+                h->Release();
+                h = nullptr;
+            }
+        if (_interop)
+        {
+            _interop->Release();
+            _interop = nullptr;
+        }
+        _vk = VK_NULL_HANDLE;
+        _ready = false;
+        _frames = 0;
+        _kicks = 0;
+        _layer = 0;
+        _zbase = 0;
+        _cleared = false;
+    }
+
+    ~AnfVkBridge() { Release(); }
+
+  private:
+    static constexpr uint32_t NR = 8;     // marker ring (frames); acks are read NR-2 frames later
+    static constexpr uint32_t Ring = 16;  // descriptor sets per pass
+    struct Img
+    {
+        VkImage image = VK_NULL_HANDLE;
+        VkFormat fmt = VK_FORMAT_UNDEFINED;
+        VkImageLayout layout = VK_IMAGE_LAYOUT_GENERAL;
+        VkImageAspectFlags aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+    };
+    struct Own
+    {
+        VkImage img = VK_NULL_HANDLE;
+        VkImageView view = VK_NULL_HANDLE;
+        VkDeviceMemory mem = VK_NULL_HANDLE;
+    };
+    struct Buf
+    {
+        VkBuffer buf = VK_NULL_HANDLE;
+        VkDeviceMemory mem = VK_NULL_HANDLE;
+        uint8_t* map = nullptr;
+        VkDeviceAddress addr = 0;
+    };
+    struct PrePush
+    {
+        uint64_t net;
+        int32_t lw, lh, canvasW, invDepth;
+        float e, mvsx, mvsy;
+    };
+    struct PostPush
+    {
+        uint64_t net;
+        int32_t hw, hh, canvasW, writeT;
+        float qx, qy, e;
+    };
+    struct RingSlot
+    {
+        uint32_t mask = 0;
+        uint32_t op[2] {};
+        uint64_t seq[2] {};
+    };
+
+    // ---- device helpers
+    uint32_t MemType(uint32_t bits, VkMemoryPropertyFlags want)
+    {
+        VkPhysicalDeviceMemoryProperties mp;
+        vkGetPhysicalDeviceMemoryProperties(_physical, &mp);
+        for (uint32_t i = 0; i < mp.memoryTypeCount; i++)
+            if ((bits >> i & 1) && (mp.memoryTypes[i].propertyFlags & want) == want)
+                return i;
+        return UINT32_MAX;
+    }
+    bool MkBuf(VkDeviceSize sz, VkBufferUsageFlags u, VkMemoryPropertyFlags fl, Buf& b)
+    {
+        VkBufferCreateInfo bc { VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+        bc.size = sz;
+        bc.usage = u | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT;
+        if (vkCreateBuffer(_vk, &bc, nullptr, &b.buf) != VK_SUCCESS)
+            return false;
+        VkMemoryRequirements mr;
+        vkGetBufferMemoryRequirements(_vk, b.buf, &mr);
+        VkMemoryAllocateFlagsInfo fi { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO };
+        fi.flags = VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT;
+        VkMemoryAllocateInfo mi { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+        mi.pNext = &fi;
+        mi.allocationSize = mr.size;
+        mi.memoryTypeIndex = MemType(mr.memoryTypeBits, fl);
+        if (mi.memoryTypeIndex == UINT32_MAX || vkAllocateMemory(_vk, &mi, nullptr, &b.mem) != VK_SUCCESS ||
+            vkBindBufferMemory(_vk, b.buf, b.mem, 0) != VK_SUCCESS)
+            return false;
+        if ((fl & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) && vkMapMemory(_vk, b.mem, 0, VK_WHOLE_SIZE, 0, (void**) &b.map) != VK_SUCCESS)
+            return false;
+        VkBufferDeviceAddressInfo ai { VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO };
+        ai.buffer = b.buf;
+        b.addr = vkGetBufferDeviceAddress(_vk, &ai);
+        return true;
+    }
+    bool MkImage(VkFormat fmt, uint32_t w, uint32_t h, Own& o)
+    {
+        VkImageCreateInfo ic { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+        ic.imageType = VK_IMAGE_TYPE_2D;
+        ic.format = fmt;
+        ic.extent = { w, h, 1 };
+        ic.mipLevels = 1;
+        ic.arrayLayers = 1;
+        ic.samples = VK_SAMPLE_COUNT_1_BIT;
+        ic.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ic.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+        ic.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        if (vkCreateImage(_vk, &ic, nullptr, &o.img) != VK_SUCCESS)
+            return false;
+        VkMemoryRequirements req;
+        vkGetImageMemoryRequirements(_vk, o.img, &req);
+        VkMemoryAllocateInfo ai { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+        ai.allocationSize = req.size;
+        ai.memoryTypeIndex = MemType(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        if (ai.memoryTypeIndex == UINT32_MAX || vkAllocateMemory(_vk, &ai, nullptr, &o.mem) != VK_SUCCESS ||
+            vkBindImageMemory(_vk, o.img, o.mem, 0) != VK_SUCCESS)
+            return false;
+        VkImageViewCreateInfo vi { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+        vi.image = o.img;
+        vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vi.format = fmt;
+        vi.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+        return vkCreateImageView(_vk, &vi, nullptr, &o.view) == VK_SUCCESS;
+    }
+    VkPipeline MkPipe(const uint32_t* code, size_t bytes, VkPipelineLayout pl)
+    {
+        VkShaderModuleCreateInfo mi { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+        mi.codeSize = bytes;
+        mi.pCode = code;
+        VkShaderModule mod = VK_NULL_HANDLE;
+        if (vkCreateShaderModule(_vk, &mi, nullptr, &mod) != VK_SUCCESS)
+            return VK_NULL_HANDLE;
+        VkComputePipelineCreateInfo ci { VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO };
+        ci.stage = { VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO };
+        ci.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+        ci.stage.module = mod;
+        ci.stage.pName = "main";
+        ci.layout = pl;
+        VkPipeline p = VK_NULL_HANDLE;
+        if (vkCreateComputePipelines(_vk, VK_NULL_HANDLE, 1, &ci, nullptr, &p) != VK_SUCCESS)
+            p = VK_NULL_HANDLE;
+        vkDestroyShaderModule(_vk, mod, nullptr);
+        return p;
+    }
+    bool Fail(const char* what)
+    {
+        LOG_ERROR("Vela ANF: {} failed", what);
+        return false;
+    }
+
+    bool MakeGpu()
+    {
+        // descriptor layouts: pre 0..4 sampled images, 5..6 storage images; post 0..2 sampled, 3..5 storage
+        auto dsl = [&](uint32_t nSampled, uint32_t nStorage, VkDescriptorSetLayout& out)
+        {
+            std::vector<VkDescriptorSetLayoutBinding> b;
+            for (uint32_t i = 0; i < nSampled + nStorage; i++)
+                b.push_back({ i, i < nSampled ? VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1,
+                              VK_SHADER_STAGE_COMPUTE_BIT, nullptr });
+            VkDescriptorSetLayoutCreateInfo ci { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+            ci.bindingCount = (uint32_t) b.size();
+            ci.pBindings = b.data();
+            return vkCreateDescriptorSetLayout(_vk, &ci, nullptr, &out) == VK_SUCCESS;
+        };
+        if (!dsl(5, 2, _preDsl) || !dsl(3, 3, _postDsl))
+            return Fail("descriptor set layouts");
+        auto lay = [&](VkDescriptorSetLayout d, uint32_t sz, VkPipelineLayout& out)
+        {
+            const VkPushConstantRange pr { VK_SHADER_STAGE_COMPUTE_BIT, 0, sz };
+            VkPipelineLayoutCreateInfo li { VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+            li.setLayoutCount = 1;
+            li.pSetLayouts = &d;
+            li.pushConstantRangeCount = 1;
+            li.pPushConstantRanges = &pr;
+            return vkCreatePipelineLayout(_vk, &li, nullptr, &out) == VK_SUCCESS;
+        };
+        if (!lay(_preDsl, sizeof(PrePush), _preLayout) || !lay(_postDsl, sizeof(PostPush), _postLayout))
+            return Fail("pipeline layouts");
+        _prePipe = MkPipe(AnfSpv::kPre, sizeof AnfSpv::kPre, _preLayout);
+        _postPipe = MkPipe(AnfSpv::kPost16, sizeof AnfSpv::kPost16, _postLayout);
+        if (!_prePipe || !_postPipe)
+            return Fail("compute pipelines (BDA / int64 shaders)");
+        const VkDescriptorPoolSize ps[2] = { { VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 8 * Ring }, { VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 5 * Ring } };
+        VkDescriptorPoolCreateInfo dp { VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO };
+        dp.maxSets = 2 * Ring;
+        dp.poolSizeCount = 2;
+        dp.pPoolSizes = ps;
+        if (vkCreateDescriptorPool(_vk, &dp, nullptr, &_pool) != VK_SUCCESS)
+            return Fail("descriptor pool");
+        for (uint32_t i = 0; i < Ring; i++)
+            for (int k = 0; k < 2; k++)
+            {
+                VkDescriptorSetAllocateInfo ai { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO };
+                ai.descriptorPool = _pool;
+                ai.descriptorSetCount = 1;
+                ai.pSetLayouts = k ? &_postDsl : &_preDsl;
+                if (vkAllocateDescriptorSets(_vk, &ai, k ? &_postSet[i] : &_preSet[i]) != VK_SUCCESS)
+                    return Fail("descriptor sets");
+            }
+        for (int i = 0; i < 2; i++)
+            if (!MkImage(VK_FORMAT_R16G16B16A16_SFLOAT, 2 * _rw, 2 * _rh, _hist[i]) ||
+                !MkImage(VK_FORMAT_R32_SFLOAT, 2 * _rw, 2 * _rh, _feat[i]))
+                return Fail("history images");
+        if (!MkImage(VK_FORMAT_R32G32B32A32_SFLOAT, _rw, _rh, _colLR) || !MkImage(VK_FORMAT_R32G32_SFLOAT, _rw, _rh, _mvLR))
+            return Fail("LR images");
+        // stand-in network buffer (zero out): in = canvas x 32 B, out = canvas x 16 B (net grid canvas/2 x 64 B)
+        _dummyOut = (VkDeviceSize) _cw * _ch * 32;
+        const VkDeviceSize dsz = _dummyOut + (VkDeviceSize) _cw * _ch * 16;
+        if (!MkBuf(dsz, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, _dummy))
+            return Fail("stand-in buffer");
+        std::memset(_dummy.map, 0, (size_t) dsz);
+        if (!MkBuf(NR * 512, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+                   VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, _markers))
+            return Fail("marker buffer");
+        std::memset(_markers.map, 0, NR * 512);
+        VkImageCreateInfo ic { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };  // 1x1 carrier image the layer's img_ok check wants
+        ic.imageType = VK_IMAGE_TYPE_2D;
+        ic.format = VK_FORMAT_R32_UINT;
+        ic.extent = { 1, 1, 1 };
+        ic.mipLevels = 1;
+        ic.arrayLayers = 1;
+        ic.samples = VK_SAMPLE_COUNT_1_BIT;
+        ic.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ic.usage = VK_IMAGE_USAGE_STORAGE_BIT;
+        if (vkCreateImage(_vk, &ic, nullptr, &_dimg) != VK_SUCCESS)
+            return Fail("carrier image");
+        VkMemoryRequirements mr;
+        vkGetImageMemoryRequirements(_vk, _dimg, &mr);
+        VkMemoryAllocateInfo mi { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+        mi.allocationSize = mr.size;
+        mi.memoryTypeIndex = MemType(mr.memoryTypeBits, 0);
+        if (mi.memoryTypeIndex == UINT32_MAX || vkAllocateMemory(_vk, &mi, nullptr, &_dmem) != VK_SUCCESS ||
+            vkBindImageMemory(_vk, _dimg, _dmem, 0) != VK_SUCCESS)
+            return Fail("carrier memory");
+        return true;
+    }
+
+    // ---- game images
+    bool Get(const Tex& t, Img& img, bool depth)
+    {
+        UINT64 handle = 0, offset = 0;
+        if (FAILED(_interop->GetVulkanResourceInfo1(t.res, &handle, &offset, &img.fmt)) || handle == 0)
+            return false;
+        img.image = (VkImage) handle;
+        _interop->GetVulkanImageLayout(t.res, t.state, &img.layout);
+        if (depth)
+        {
+            const bool stencil = img.fmt == VK_FORMAT_D32_SFLOAT_S8_UINT;
+            img.aspect = (VkImageAspectFlags) ((stencil || img.fmt == VK_FORMAT_D32_SFLOAT)
+                                                   ? (VK_IMAGE_ASPECT_DEPTH_BIT | (stencil ? VK_IMAGE_ASPECT_STENCIL_BIT : 0))
+                                                   : VK_IMAGE_ASPECT_COLOR_BIT);
+        }
+        return true;
+    }
+    // a view for this call only, destroyed 8 x Ring calls later (the game may free the image, vkd3d-proton reuse the handle)
+    VkImageView View(const Img& src, bool depth)
+    {
+        _viewCalls++;
+        while (!_retire.empty() && _retire.front().first + 8 * Ring <= _viewCalls)
+        {
+            vkDestroyImageView(_vk, _retire.front().second, nullptr);
+            _retire.pop_front();
+        }
+        const bool depthFmt = src.fmt == VK_FORMAT_D32_SFLOAT || src.fmt == VK_FORMAT_D32_SFLOAT_S8_UINT;
+        if (depth && !depthFmt && src.fmt != VK_FORMAT_R32_SFLOAT)
+            return VK_NULL_HANDLE;
+        VkImageViewCreateInfo vi { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+        vi.image = src.image;
+        vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vi.format = src.fmt;
+        vi.subresourceRange = { depth && depthFmt ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+        VkImageView v = VK_NULL_HANDLE;
+        if (vkCreateImageView(_vk, &vi, nullptr, &v) != VK_SUCCESS)
+            return VK_NULL_HANDLE;
+        _retire.push_back({ _viewCalls, v });
+        return v;
+    }
+    // inputs are sampled as SHADER_READ_ONLY_OPTIMAL, the output is written as GENERAL; there and back around the passes
+    void Transition(VkCommandBuffer cb, const Img* in, int n, const Img& out, bool toUs)
+    {
+        VkImageMemoryBarrier b[4] {};
+        uint32_t k = 0;
+        auto add = [&](const Img& img, VkImageLayout ours)
+        {
+            if (img.layout == ours)
+                return;
+            auto& x = b[k++];
+            x.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+            x.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+            x.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+            x.oldLayout = toUs ? img.layout : ours;
+            x.newLayout = toUs ? ours : img.layout;
+            x.srcQueueFamilyIndex = x.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            x.image = img.image;
+            x.subresourceRange = { img.aspect, 0, 1, 0, 1 };
+        };
+        for (int i = 0; i < n; i++)
+            add(in[i], VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+        add(out, VK_IMAGE_LAYOUT_GENERAL);
+        VkMemoryBarrier mb { VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+        mb.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+        mb.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+        vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0, nullptr, k,
+                             k ? b : nullptr);
+    }
+    bool MakeFlush(ID3D12Device* device)
+    {
+        D3D12_HEAP_PROPERTIES hp { D3D12_HEAP_TYPE_DEFAULT };
+        D3D12_RESOURCE_DESC rd {};
+        rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        rd.Width = 256;
+        rd.Height = 1;
+        rd.DepthOrArraySize = 1;
+        rd.MipLevels = 1;
+        rd.SampleDesc.Count = 1;
+        rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        for (auto*& b : _flush)
+            if (FAILED(device->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &rd, D3D12_RESOURCE_STATE_COMMON, nullptr,
+                                                       IID_PPV_ARGS(&b))))
+                return Fail("flush buffers");
+        const D3D12_DESCRIPTOR_HEAP_TYPE types[2] = { D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV, D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER };
+        for (int i = 0; i < 2; i++)
+        {
+            D3D12_DESCRIPTOR_HEAP_DESC hd {};
+            hd.Type = types[i];
+            hd.NumDescriptors = 1;
+            hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+            if (FAILED(device->CreateDescriptorHeap(&hd, IID_PPV_ARGS(&_dummyHeap[i]))))
+                return Fail("descriptor heaps");
+        }
+        return true;
+    }
+    // vkd3d-proton binds the game's descriptor heaps again only when SetDescriptorHeaps names other heaps (Fsr4VkBridge::HandHeapsBack)
+    void HandHeapsBack(ID3D12GraphicsCommandList* cl)
+    {
+        ID3D12DescriptorHeap* h[2] = { _dummyHeap[0], _dummyHeap[1] };
+        if (h[0] && h[1])
+            cl->SetDescriptorHeaps(2, h);
+    }
+
+    // ---- NPU markers (the layer's vkCmdUpdateBuffer route)
+    void Marker(VkCommandBuffer cb, uint32_t ri, uint32_t k, uint32_t op, uint64_t seq, uint32_t flags, int phase)
+    {
+        VelaNpuCmd m {};
+        m.magic = VELA_NPU_MAGIC_CMD;
+        m.version = VELA_NPU_VERSION;
+        m.op = op;
+        m.seq = seq;
+        m.flags = flags | VELA_NPU_F_GRAPH;
+        if (op == VELA_NPU_OP_UPSCALE)
+        {
+            const VelaNpuImage im { (uint64_t) (uintptr_t) _dimg, VK_FORMAT_R32_UINT, VK_IMAGE_LAYOUT_GENERAL, 1, 1, VK_IMAGE_ASPECT_COLOR_BIT, 0 };
+            m.color = im;
+            m.output = im;
+            m.pad0 = _gen;
+            if (flags & VELA_NPU_F_PHASE)
+                m.reserved[34] = (uint8_t) phase;
+        }
+        std::snprintf(reinterpret_cast<char*>(m.reserved), 32, "%s", _family.c_str());
+        vkCmdUpdateBuffer(cb, _markers.buf, VkDeviceSize(ri) * 512 + k * 256, sizeof m, &m);
+        _ring[ri].mask |= 1u << k;
+        _ring[ri].op[k] = op;
+        _ring[ri].seq[k] = seq;
+    }
+    void Drain(uint64_t f)
+    {
+        RingSlot& r = _ring[f % NR];
+        for (uint32_t k = 0; k < 2; k++)
+        {
+            if (!(r.mask >> k & 1))
+                continue;
+            VelaNpuAck a;
+            std::memcpy(&a, _markers.map + (f % NR) * 512 + k * 256, sizeof a);
+            const uint32_t op = r.op[k];
+            if (a.magic == VELA_NPU_MAGIC_CMD)  // the driver just stored the payload: no layer below us
+            {
+                if (op == VELA_NPU_OP_PROBE)
+                {
+                    _layer = -1;
+                    LOG_INFO("Vela ANF: no NPU layer (plain upscale)");
+                }
+                else
+                    ++_fb;
+                continue;
+            }
+            if (a.magic != VELA_NPU_MAGIC_ACK || a.seq != r.seq[k])
+            {
+                if (op == VELA_NPU_OP_PROBE)
+                    _layer = 0;
+                else if (op == VELA_NPU_OP_WAIT)
+                    ++_fb;
+                continue;
+            }
+            uint32_t caps;
+            std::memcpy(&caps, a.reserved, 4);
+            if ((caps & VELA_NPU_CAP_ZEROCOPY) && (caps & VELA_NPU_CAP_BDA))
+            {
+                uint32_t g, q[3];
+                uint64_t b;
+                std::memcpy(&g, a.reserved + 16, 4);
+                std::memcpy(q, a.reserved + 20, 12);
+                std::memcpy(&b, a.reserved + 32, 8);
+                if (b)
+                {
+                    _gen = g;
+                    _zbase = b;
+                    _qin = q[0];
+                    _qout = q[1];
+                }
+            }
+            if (op == VELA_NPU_OP_PROBE)
+            {
+                if (a.status == VELA_NPU_ACK_OK && (caps & VELA_NPU_CAP_ZEROCOPY) && (caps & VELA_NPU_CAP_BDA) && _zbase)
+                {
+                    _layer = 2;
+                    LOG_INFO("Vela ANF: NPU up, family {} (frame {}), zero-copy in @{} out @{} (16 B units)", _family, _frames, _qin, _qout);
+                }
+                else
+                {
+                    _layer = -2;
+                    _probeFrame = _frames;
+                    LOG_INFO("Vela ANF: NPU refused (status {}) caps {}; plain upscale, probe again in 300 frames", (int) a.status, caps);
+                }
+            }
+            else if (op == VELA_NPU_OP_WAIT)
+            {
+                if (a.status == VELA_NPU_ACK_OK)
+                {
+                    uint32_t us;
+                    std::memcpy(&us, a.reserved + 4, 4);
+                    ++_ok;
+                    _htpSum += us / 1000.0;
+                    _htpMax = std::max(_htpMax, us / 1000.0);
+                    ++_lineOk;
+                    _lineHtp += us / 1000.0;
+                    _fbRun = 0;
+                }
+                else
+                {
+                    ++_fb;
+                    ++_lineFb;
+                    if (++_fbRun >= 3)
+                        _layer = 0;  // lost the daemon: probe again
+                }
+            }
+        }
+        r.mask = 0;
+        if (_lineOk + _lineFb >= 600)
+        {
+            LOG_INFO("Vela NPU: ANF {} frames, HTP {:.2f} ms, fallbacks {}", _lineOk + _lineFb, _lineOk ? _lineHtp / _lineOk : 0.0, _lineFb);
+            _lineOk = _lineFb = 0;
+            _lineHtp = 0;
+        }
+    }
+    void Stats()
+    {
+        std::string h;
+        for (int i = 0; i < 32; i++)
+            if (_phaseHist[i])
+                h += std::to_string(i) + ":" + std::to_string(_phaseHist[i]) + " ";
+        LOG_INFO("ANFSTATS frames {} kicks {} htp_ok {} fallbacks {} standin {} family {} layer {} htp_ms mean {:.3f} max {:.3f} phase_hist {}", _frames,
+                 _kicks, _ok, _fb, _standIn, _family, _layer, _ok ? _htpSum / _ok : 0.0, _htpMax, h);
+    }
+
+    static void Write(VkDescriptorSet set, uint32_t b, VkImageView v, bool storage, VkWriteDescriptorSet* w, VkDescriptorImageInfo* ii)
+    {
+        ii[b] = { VK_NULL_HANDLE, v, VK_IMAGE_LAYOUT_GENERAL };
+        w[b] = { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET };
+        w[b].dstSet = set;
+        w[b].dstBinding = b;
+        w[b].descriptorCount = 1;
+        w[b].descriptorType = storage ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+        w[b].pImageInfo = &ii[b];
+    }
+    static void Bar(VkCommandBuffer cb)
+    {
+        VkMemoryBarrier mb { VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+        mb.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT | VK_ACCESS_HOST_WRITE_BIT;
+        mb.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT | VK_ACCESS_HOST_READ_BIT;
+        vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0, nullptr, 0, nullptr);
+    }
+
+    void Record(VkCommandBuffer cb, VkImageView vc, VkImageView vd, VkImageView vm, VkImageView vo, const Frame& f)
+    {
+        const uint32_t ri = (uint32_t) (_frames % NR);
+        const uint32_t par = (uint32_t) (_frames & 1), prv = par ^ 1;
+        // acks of NR-2 frames ago; probe state machine
+        if (_frames >= NR - 2)
+            Drain(_frames - (NR - 2));
+        _ring[ri].mask = 0;
+        std::memset(_markers.map + ri * 512, 0, 512);
+        if (_layer == -2 && _frames - _probeFrame > 300)
+            _layer = 0;
+        if (_layer == 1 && _frames - _probeFrame > NR)
+            _layer = 0;
+        // own images to GENERAL once; histories cleared on first use / reset
+        if (!_cleared || f.reset)
+        {
+            std::vector<VkImageMemoryBarrier> b;
+            for (VkImage im : { _hist[0].img, _hist[1].img, _feat[0].img, _feat[1].img, _colLR.img, _mvLR.img })
+            {
+                VkImageMemoryBarrier x { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+                x.srcAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+                x.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+                x.oldLayout = _cleared ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_UNDEFINED;
+                x.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+                x.srcQueueFamilyIndex = x.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+                x.image = im;
+                x.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+                b.push_back(x);
+            }
+            vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr,
+                                 (uint32_t) b.size(), b.data());
+            const VkClearColorValue z {};
+            const VkImageSubresourceRange rg { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+            for (VkImage im : { _hist[0].img, _hist[1].img, _feat[0].img, _feat[1].img })
+                vkCmdClearColorImage(cb, im, VK_IMAGE_LAYOUT_GENERAL, &z, 1, &rg);
+            Bar(cb);
+            _cleared = true;
+        }
+        // phase from the jitter (ANF: (-jx, +jy); ix = floor((jxA + 0.5) * 8); 32 sets: graph j = (iy >> 1) * 8 + ix)
+        const float jxa = -f.jitterX, jya = f.jitterY;
+        const int ix = std::min(7, std::max(0, (int) std::floor((jxa + 0.5f) * 8.0f)));
+        const int iy = std::min(7, std::max(0, (int) std::floor((jya + 0.5f) * 8.0f)));
+        const int phase = (iy >> 1) * 8 + ix;
+        if (_layer == 0)
+        {
+            Marker(cb, ri, 0, VELA_NPU_OP_PROBE, ++_seq, 0, 0);
+            _layer = 1;
+            _probeFrame = _frames;
+        }
+        const bool npu = _layer == 2 && _zbase != 0;
+        const VkDeviceAddress inAddr = npu ? _zbase + VkDeviceAddress(_qin) * 16 : _dummy.addr;
+        const VkDeviceAddress outAddr = npu ? _zbase + VkDeviceAddress(_qout) * 16 : _dummy.addr + _dummyOut;
+        const uint32_t si = (uint32_t) (_frames % Ring);
+        VkDescriptorSet ps = _preSet[si], qs = _postSet[si];
+        VkWriteDescriptorSet w[7] {};
+        VkDescriptorImageInfo ii[7] {};
+        // pre: colour, depth, mv (game), history/feature of the previous frame, LR colour + chosen MV out
+        Write(ps, 0, vc, false, w, ii);
+        Write(ps, 1, vd, false, w, ii);
+        Write(ps, 2, vm, false, w, ii);
+        Write(ps, 3, _hist[prv].view, false, w, ii);
+        Write(ps, 4, _feat[prv].view, false, w, ii);
+        Write(ps, 5, _colLR.view, true, w, ii);
+        Write(ps, 6, _mvLR.view, true, w, ii);
+        vkUpdateDescriptorSets(_vk, 7, w, 0, nullptr);
+        VkWriteDescriptorSet w2[6] {};
+        VkDescriptorImageInfo i2[6] {};
+        Write(qs, 0, _colLR.view, false, w2, i2);
+        Write(qs, 1, _mvLR.view, false, w2, i2);
+        Write(qs, 2, _hist[prv].view, false, w2, i2);
+        Write(qs, 3, _hist[par].view, true, w2, i2);
+        Write(qs, 4, _feat[par].view, true, w2, i2);
+        Write(qs, 5, vo, true, w2, i2);
+        vkUpdateDescriptorSets(_vk, 6, w2, 0, nullptr);
+
+        PrePush pp {};
+        pp.net = inAddr;
+        pp.lw = (int32_t) _rw;
+        pp.lh = (int32_t) _rh;
+        pp.canvasW = (int32_t) _cw;
+        pp.invDepth = _depthInverted ? 0 : 1;  // the pre pass wants larger = nearer
+        pp.e = 1.0f;
+        pp.mvsx = -f.mvScaleX;  // FFX MV (prev - curr) x MV scale -> ANF curr - prev in render px
+        pp.mvsy = -f.mvScaleY;
+        vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, _prePipe);
+        vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, _preLayout, 0, 1, &ps, 0, nullptr);
+        vkCmdPushConstants(cb, _preLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pp, &pp);
+        vkCmdDispatch(cb, (_rw + 7) / 8, (_rh + 7) / 8, 1);
+        Bar(cb);
+        if (npu)
+        {
+            // the kick (layer E1, with the family phase) and the wait for the same frame: pre -> NPU -> post in order
+            const uint32_t kfl = VELA_NPU_F_TENSORS | VELA_NPU_F_ASYNC | VELA_NPU_F_ZEROCOPY | VELA_NPU_F_PHASE;
+            const uint64_t s = ++_seq;
+            Marker(cb, ri, 1, VELA_NPU_OP_UPSCALE, s, kfl, phase);
+            Marker(cb, ri, 0, VELA_NPU_OP_WAIT, s, 0, 0);
+            ++_kicks;
+            ++_phaseHist[phase & 31];
+            Bar(cb);
+        }
+        else
+            ++_standIn;
+        PostPush qp {};
+        qp.net = outAddr;
+        qp.hw = (int32_t) (2 * _rw);
+        qp.hh = (int32_t) (2 * _rh);
+        qp.canvasW = (int32_t) _cw;
+        qp.writeT = 0;
+        qp.qx = ((float) ix + 0.5f) / 8.0f - 0.5f;
+        qp.qy = ((float) iy + 0.5f) / 8.0f - 0.5f;
+        qp.e = 1.0f;
+        vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, _postPipe);
+        vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, _postLayout, 0, 1, &qs, 0, nullptr);
+        vkCmdPushConstants(cb, _postLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof qp, &qp);
+        vkCmdDispatch(cb, (2 * _rw + 7) / 8, (2 * _rh + 7) / 8, 1);
+        Bar(cb);
+        if (_frames == 0 || (_frames % 600) == 0)
+            LOG_INFO("Vela ANF: frame {} phase {} (ix {} iy {}) npu {} stand-in frames {} layer state {}", _frames, phase, ix, iy, npu,
+                     _standIn, _layer);
+    }
+
+    ID3D12DXVKInteropDevice1* _interop = nullptr;
+    VkDevice _vk = VK_NULL_HANDLE;
+    VkPhysicalDevice _physical = VK_NULL_HANDLE;
+    ID3D12Resource* _flush[2] = { nullptr, nullptr };
+    ID3D12DescriptorHeap* _dummyHeap[2] = { nullptr, nullptr };
+    uint32_t _rw = 0, _rh = 0, _dw = 0, _dh = 0, _cw = 0, _ch = 0;
+    bool _depthInverted = true, _hdr = false, _ready = false, _cleared = false;
+    std::string _family;
+    VkDescriptorSetLayout _preDsl = VK_NULL_HANDLE, _postDsl = VK_NULL_HANDLE;
+    VkPipelineLayout _preLayout = VK_NULL_HANDLE, _postLayout = VK_NULL_HANDLE;
+    VkPipeline _prePipe = VK_NULL_HANDLE, _postPipe = VK_NULL_HANDLE;
+    VkDescriptorPool _pool = VK_NULL_HANDLE;
+    VkDescriptorSet _preSet[Ring] {}, _postSet[Ring] {};
+    Own _hist[2], _feat[2], _colLR, _mvLR;
+    Buf _dummy, _markers;
+    VkDeviceSize _dummyOut = 0;
+    VkImage _dimg = VK_NULL_HANDLE;
+    VkDeviceMemory _dmem = VK_NULL_HANDLE;
+    std::deque<std::pair<uint64_t, VkImageView>> _retire;
+    uint64_t _viewCalls = 0, _frames = 0, _seq = 0, _kicks = 0, _ok = 0, _fb = 0, _lineOk = 0, _lineFb = 0, _standIn = 0, _probeFrame = 0;
+    uint32_t _fbRun = 0;
+    double _htpSum = 0, _htpMax = 0, _lineHtp = 0;
+    int _layer = 0;  // 0 not probed, 1 PROBE in flight, 2 NPU up, -1 no layer, -2 refused
+    uint32_t _gen = 0, _qin = 0, _qout = 0, _failLogged = 0;
+    VkDeviceAddress _zbase = 0;
+    RingSlot _ring[NR];
+    uint64_t _phaseHist[32] {};
+};
