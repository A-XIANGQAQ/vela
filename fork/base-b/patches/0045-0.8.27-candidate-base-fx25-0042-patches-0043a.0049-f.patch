diff --git a/arm64ec/tests/unity_vk_patch_test.cpp b/arm64ec/tests/unity_vk_patch_test.cpp
new file mode 100644
index 00000000..869b312d
--- /dev/null
+++ b/arm64ec/tests/unity_vk_patch_test.cpp
@@ -0,0 +1,149 @@
+// Host-side test of Vela 0044 (OptiScaler/hooks/VelaUnityVkCore.h). Not part of the DLL.
+//   x86_64-w64-mingw32-clang++ -std=c++20 -O1 -I OptiScaler/hooks arm64ec/tests/unity_vk_patch_test.cpp -o t.exe
+//   t.exe [path to the game's NVUnityPlugin.dll]
+// With a path, the real plugin is mapped as an image WITHOUT running any of its code (DONT_RESOLVE_DLL_REFERENCES: no
+// imports, no DllMain) and the scan + change run on that private mapping; the file on disk is not written.
+
+#include "VelaUnityVkCore.h"
+
+#include <cstdio>
+#include <vector>
+
+using namespace vela_unity_vk;
+
+static int g_checks = 0, g_failed = 0;
+#define CHECK(x)                                                                                                       \
+    do                                                                                                                 \
+    {                                                                                                                  \
+        g_checks++;                                                                                                    \
+        if (!(x))                                                                                                      \
+        {                                                                                                              \
+            g_failed++;                                                                                                \
+            std::printf("FAIL line %d: %s\n", __LINE__, #x);                                                           \
+        }                                                                                                              \
+    } while (0)
+
+static void Put(std::vector<uint8_t>& b, size_t at, uint8_t value)
+{
+    const uint8_t sig[kSigSize] = { 0xC7, 0x44, 0x24, 0x30, value, 0x00, 0x00, 0x00, 0xC7, 0x44, 0x24, 0x34,
+                                    0x00, 0x00, 0x00, 0x00, 0xC7, 0x44, 0x24, 0x38, 0x09, 0x00, 0x00, 0x00 };
+    std::memcpy(b.data() + at, sig, kSigSize);
+}
+
+static void TestCount()
+{
+    std::vector<uint8_t> b(4096, 0xCC);
+    const uint8_t* first = nullptr;
+    CHECK(CountInRange(b.data(), b.size(), kInside, &first) == 0 && first == nullptr);
+    CHECK(CountInRange(nullptr, 100, kInside, nullptr) == 0);
+    CHECK(CountInRange(b.data(), kSigSize - 1, kInside, nullptr) == 0);
+
+    Put(b, 100, kInside);
+    CHECK(CountInRange(b.data(), b.size(), kInside, &first) == 1 && first == b.data() + 100);
+    CHECK(CountInRange(b.data(), b.size(), kOutside, nullptr) == 0);
+    CHECK(CountInRange(b.data(), 100 + kSigSize, kInside, nullptr) == 1);     // ends exactly at the buffer end
+    CHECK(CountInRange(b.data(), 100 + kSigSize - 1, kInside, nullptr) == 0); // one byte short
+
+    Put(b, 4096 - kSigSize, kInside); // a second one at the very end
+    first = nullptr;
+    CHECK(CountInRange(b.data(), b.size(), kInside, &first) == 2 && first == b.data() + 100);
+
+    Put(b, 100, kOutside);
+    CHECK(CountInRange(b.data(), b.size(), kInside, nullptr) == 1);
+    CHECK(CountInRange(b.data(), b.size(), kOutside, &first) == 1 && first == b.data() + 100);
+
+    // near misses: another stack slot, another flags value, another precondition value
+    std::vector<uint8_t> c(256, 0x90);
+    Put(c, 16, kInside);
+    c[16 + 3] = 0x40;
+    CHECK(CountInRange(c.data(), c.size(), kInside, nullptr) == 0);
+    Put(c, 16, kInside);
+    c[16 + 20] = 0x08;
+    CHECK(CountInRange(c.data(), c.size(), kInside, nullptr) == 0);
+    Put(c, 16, 0x00);
+    CHECK(CountInRange(c.data(), c.size(), kInside, nullptr) == 0 &&
+          CountInRange(c.data(), c.size(), kOutside, nullptr) == 0);
+
+    // not an image
+    std::vector<uint8_t> junk(8192, 0);
+    CHECK(!Scan(junk.data()).validImage && !Scan(nullptr).validImage);
+    uint32_t rva = 0;
+    int hits = 0;
+    CHECK(Patch(junk.data(), &rva, &hits) == PatchResult::NotAnImage);
+
+    // 0045: the first RIP-relative 64-bit store
+    std::vector<uint8_t> f(0x100, 0x90);
+    CHECK(FirstRipStore64(f.data(), kStoreWindow) == nullptr && FirstRipStore64(nullptr, kStoreWindow) == nullptr);
+    const uint8_t prologue[] = { 0x48, 0x89, 0x4C, 0x24, 0x08, 0x48, 0x83, 0xEC, 0x28, 0x48, 0x8B, 0x44, 0x24, 0x30,
+                                 0x48, 0x89, 0x05, 0x10, 0x00, 0x00, 0x00 }; // the real function, first bytes
+    std::memcpy(f.data(), prologue, sizeof(prologue));
+    CHECK(FirstRipStore64(f.data(), kStoreWindow) == f.data() + sizeof(prologue) + 0x10); // not the [rsp+8] store
+    f[14] = 0x4C; // mov [rip+disp], r8
+    CHECK(FirstRipStore64(f.data(), kStoreWindow) == f.data() + sizeof(prologue) + 0x10);
+    f[16] = 0x45; // mod = 01: not RIP-relative
+    CHECK(FirstRipStore64(f.data(), kStoreWindow) == nullptr);
+    f[16] = 0x05;
+    CHECK(FirstRipStore64(f.data(), 20) == nullptr); // the store ends past the window
+    CHECK(ImageSize(junk.data()) == 0 && FollowJumps(f.data(), junk.data()) == f.data()); // no E9: unchanged
+    f[0] = 0xE9;
+    CHECK(FollowJumps(f.data(), junk.data()) == nullptr); // a jump out of a non-image
+}
+
+static void TestRealPlugin(const wchar_t* path)
+{
+    HMODULE m = LoadLibraryExW(path, nullptr, DONT_RESOLVE_DLL_REFERENCES);
+    CHECK(m != nullptr);
+    if (m == nullptr)
+    {
+        std::printf("cannot map the plugin, error %lu\n", GetLastError());
+        return;
+    }
+    auto* base = reinterpret_cast<uint8_t*>(m);
+    const ScanResult s = Scan(base);
+    std::printf("real plugin: valid %d, inside hits %d, outside hits %d, RVA 0x%X\n", (int) s.validImage, s.inside,
+                s.outside, s.rva);
+    CHECK(s.validImage && s.inside == 1 && s.outside == 0);
+    CHECK(s.rva == 0x250EC); // file offset 0x244EC in job R8B
+
+    // 0045: the global UnityPluginLoad stores IUnityInterfaces* in (UNITY_SIDE.md 3.1: VA 0x180154268)
+    auto* load = reinterpret_cast<uint8_t*>(GetProcAddress(m, "UnityPluginLoad"));
+    CHECK(load != nullptr);
+    uint8_t* fn = load != nullptr ? FollowJumps(load, base) : nullptr;
+    uint8_t* global = FirstRipStore64(fn, kStoreWindow);
+    CHECK(fn != nullptr && global != nullptr);
+    if (fn != nullptr && global != nullptr)
+    {
+        std::printf("UnityPluginLoad export RVA 0x%X -> function RVA 0x%X, global RVA 0x%X, image size 0x%X\n",
+                    (unsigned) (load - base), (unsigned) (fn - base), (unsigned) (global - base),
+                    (unsigned) ImageSize(base));
+        CHECK(fn - base == 0x35DD0);
+        CHECK(global - base == 0x154268);
+        CHECK(global >= base && global + 8 <= base + ImageSize(base));
+    }
+    CHECK(GetProcAddress(m, "NVUP_GetBaseEventId") != nullptr);
+
+    uint32_t rva = 0;
+    int hits = 0;
+    CHECK(Patch(base, &rva, &hits) == PatchResult::Patched && rva == 0x250EC && hits == 1);
+    CHECK(base[0x250EC] == kOutside && base[0x250E8] == 0xC7);
+    MEMORY_BASIC_INFORMATION mbi {};
+    VirtualQuery(base + 0x250EC, &mbi, sizeof(mbi));
+    std::printf("page protection after the change: 0x%lX\n", mbi.Protect);
+    CHECK(mbi.Protect == PAGE_EXECUTE_READ || mbi.Protect == PAGE_EXECUTE_WRITECOPY || mbi.Protect == PAGE_EXECUTE);
+
+    CHECK(Patch(base, &rva, &hits) == PatchResult::AlreadyOutside && rva == 0x250EC); // a second look changes nothing
+    const ScanResult s2 = Scan(base);
+    CHECK(s2.inside == 0 && s2.outside == 1);
+    FreeLibrary(m);
+}
+
+int wmain(int argc, wchar_t** argv)
+{
+    TestCount();
+    if (argc > 1)
+        TestRealPlugin(argv[1]);
+    else
+        std::printf("no plugin path given: the real-module part is skipped\n");
+    std::printf("unity_vk_patch_test: %d checks, %d failed\n", g_checks, g_failed);
+    return g_failed == 0 ? 0 : 1;
+}
