+                                "vkBindImageMemory", "vkCreateImageView", "vkCreateBuffer",
+                                "vkGetBufferMemoryRequirements", "vkBindBufferMemory", "vkMapMemory",
+                                "vkCreateSampler", "vkCreateDescriptorPool",
+                                "vkCreateDescriptorSetLayout", "vkAllocateDescriptorSets", "vkCreatePipelineLayout",
+                                "vkCreateShaderModule", "vkCreateComputePipelines", "vkGetBufferMemoryRequirements2KHR",
+                                "vkSetDebugUtilsObjectNameEXT" })
