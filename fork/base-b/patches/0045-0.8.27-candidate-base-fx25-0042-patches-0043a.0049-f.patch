+// 2000 frames as the Unity case runs them: Evaluate on a secondary inside a pass, executed by a primary, submitted;
+// the GPU finishes a job two frames later. Every job must be submitted by the hook, none by the stale rule, none lost.
+static void TestFrameLoopHook()
+{
+    Tracker t;
+    Ring r;
+    const Handle pool = H(1), P = H(0x100), X = H(0x200);
+    t.OnAllocate(pool, P, false);
+    t.OnAllocate(pool, X, true);
+    int hook = 0, stale = 0, noSlot = 0;
+    int inFlightAge[Ring::Size] {};
+    for (int frame = 0; frame < 2000; frame++)
+    {
+        t.OnBegin(P, false);
+        t.OnPass(P, true);
+        t.OnBegin(X, true);
+
+        // Evaluate
+        Job st[Ring::Size];
+        stale += r.Stale(st);
+        const CbQuery q = t.Query(X);
+        CHECK(q.known && q.inPass);
+        const int next = r.NextIndex();
+        if (r.At(next).state == SlotState::InFlight && inFlightAge[next] >= 2)
+            r.Complete(next);
+        const int slot = r.Acquire(1, true);
+        if (slot < 0)
+        {
+            noSlot++;
+        }
+        else
+        {
+            r.Commit(slot, frame == 0);
+            t.Watch(X, Job { slot, r.At(slot).seq });
+        }
+
+        t.OnExecute(P, 1, &X);
+        t.OnPass(P, false);
+
+        // vkQueueSubmit hook
+        std::vector<Job> jobs;
+        t.TakeForSubmit(P, jobs);
+        for (const Job& j : jobs)
+        {
+            if (r.IsReady(j))
+            {
+                r.Submitted(j.slot);
+                inFlightAge[j.slot] = 0;
+                hook++;
+            }
+        }
+        for (int i = 0; i < Ring::Size; i++)
+            if (r.At(i).state == SlotState::InFlight)
+                inFlightAge[i]++;
+    }
+    CHECK(hook == 2000 && stale == 0 && noSlot == 0 && t.WatchCount() == 0);
+}
+
+// The hooks are blind: every job is submitted at the start of the next Evaluate, in order.
+static void TestFrameLoopFallback()
+{
+    Ring r;
+    int fallback = 0, noSlot = 0;
+    uint64_t lastSeq = 0;
+    for (int frame = 0; frame < 2000; frame++)
+    {
+        Job st[Ring::Size];
+        const int n = r.Stale(st);
+        CHECK(n == (frame == 0 ? 0 : 1));
+        for (int k = 0; k < n; k++)
+        {
+            CHECK(r.IsReady(st[k]) && st[k].seq == lastSeq + 1);
+            lastSeq = st[k].seq;
+            r.Submitted(st[k].slot);
+            fallback++;
+        }
+        const int next = r.NextIndex();
+        if (r.At(next).state == SlotState::InFlight)
+            r.Complete(next); // the fence of the job 4 frames back has signalled
+        const int slot = r.Acquire(1, false);
+        if (slot < 0)
+            noSlot++;
+        else
+            r.Commit(slot, false);
+    }
+    CHECK(fallback == 1999 && noSlot == 0);
+}
+
+// A hook job whose submit never comes (the game threw the recording away) goes out through the stale rule two Evaluates
+// later and the hook, arriving late for it, does not submit it a second time.
+static void TestOrphan()
+{
+    Tracker t;
+    Ring r;
+    const Handle X = H(0x200), P = H(0x100);
+    t.OnBegin(X, true);
+    const int s0 = r.Acquire(1, true);
+    r.Commit(s0, false);
+    const Job j0 { s0, r.At(s0).seq };
+    t.Watch(X, j0);
+
+    Job st[Ring::Size];
+    CHECK(r.Stale(st) == 0); // next Evaluate: not due yet
+    const int s1 = r.Acquire(1, true);
+    r.Commit(s1, false);
+    CHECK(r.Stale(st) == 1 && st[0].slot == s0); // the Evaluate after: due
+    r.Submitted(s0);
+
+    std::vector<Job> jobs;
+    t.OnExecute(P, 1, &X);
+    t.TakeForSubmit(P, jobs);
+    CHECK(jobs.size() == 1 && !r.IsReady(jobs[0])); // late hook: already in flight
+}
+
+int main()
+{
+    TestTrackerStates();
+    TestTrackerWatch();
+    TestRing();
+    TestFrameLoopHook();
+    TestFrameLoopFallback();
+    TestOrphan();
+    std::printf("vk_defer_core_test: %d checks, %d failed\n", g_checks, g_failed);
+    return g_failed == 0 ? 0 : 1;
+}
