+static int g_checks = 0, g_failed = 0;
+#define CHECK(x)                                                                                                       \
+    do                                                                                                                 \
+    {                                                                                                                  \
+        g_checks++;                                                                                                    \
+        if (!(x))                                                                                                      \
+        {                                                                                                              \
+            g_failed++;                                                                                                \
+            std::printf("FAIL line %d: %s\n", __LINE__, #x);                                                           \
+        }                                                                                                              \
+    } while (0)
+
+static Handle H(uintptr_t v) { return (Handle) v; }
+
+static void TestTrackerStates()
+{
+    Tracker t;
+    const Handle pool = H(0x10), P = H(0x100), X = H(0x200), Y = H(0x300), U = H(0x400);
+    t.OnCreatePool(pool, 3);
+    t.OnAllocate(pool, P, false);
+    t.OnAllocate(pool, X, true);
+    t.OnAllocate(pool, Y, true);
+
+    CHECK(!t.Query(P).known); // allocated, never begun
+    CHECK(!t.Query(H(0x999)).known);
+
+    // Unity: a secondary begun with RENDER_PASS_CONTINUE
+    t.OnBegin(X, true);
+    CbQuery q = t.Query(X);
+    CHECK(q.known && q.secondary && q.inPass && q.familyKnown && q.family == 3);
+
+    // a secondary outside a render pass: compute work is valid there
+    t.OnBegin(Y, false);
+    q = t.Query(Y);
+    CHECK(q.known && q.secondary && !q.inPass);
+
+    // a primary: inside a pass only between begin and end
+    t.OnBegin(P, false);
+    CHECK(t.Query(P).known && !t.Query(P).secondary && !t.Query(P).inPass);
+    t.OnPass(P, true);
+    CHECK(t.Query(P).inPass);
+    t.OnPass(P, false);
+    CHECK(!t.Query(P).inPass);
+
+    // the spec ignores RENDER_PASS_CONTINUE on a primary
+    t.OnBegin(P, true);
+    CHECK(!t.Query(P).secondary && !t.Query(P).inPass);
+
+    // allocation not seen (made before the hooks tracked): the flag alone decides
+    t.OnBegin(U, true);
+    q = t.Query(U);
+    CHECK(q.known && q.secondary && q.inPass && !q.familyKnown);
+    t.OnBegin(U, false);
+    CHECK(t.Query(U).known && !t.Query(U).secondary && !t.Query(U).inPass);
+
+    // a render pass event on a command buffer never seen begun changes nothing
+    t.OnPass(H(0x777), true);
+    CHECK(!t.Query(H(0x777)).known);
+
+    // reset: unknown again until the next begin
+    t.OnReset(X);
+    CHECK(!t.Query(X).known);
+    t.OnBegin(X, true);
+    t.OnResetPool(pool);
+    CHECK(!t.Query(X).known && !t.Query(P).known);
+    t.OnBegin(X, true);
+    t.OnFree(X);
+    CHECK(!t.Query(X).known);
+    t.OnDestroyPool(pool);
+    CHECK(!t.Query(P).familyKnown && t.Size() == 1); // only U (no pool) is left
+}
+
+static void TestTrackerWatch()
+{
+    Tracker t;
+    const Handle pool = H(0x10), P = H(0x100), P2 = H(0x110), X = H(0x200), X2 = H(0x210);
+    t.OnAllocate(pool, P, false);
+    t.OnAllocate(pool, P2, false);
+    t.OnAllocate(pool, X, true);
+    t.OnAllocate(pool, X2, true);
+    std::vector<Job> out;
+
+    // secondary -> primary -> submit
+    t.OnBegin(P, false);
+    t.OnBegin(X, true);
+    t.Watch(X, Job { 0, 1 });
+    CHECK(t.WatchCount() == 1);
+    t.TakeForSubmit(P, out);
+    CHECK(out.empty()); // not executed yet
+    t.OnExecute(P, 1, &X);
+    t.TakeForSubmit(X, out);
+    CHECK(out.empty()); // moved away from the secondary
+    t.TakeForSubmit(P2, out);
+    CHECK(out.empty());
+    t.TakeForSubmit(P, out);
+    CHECK(out.size() == 1 && out[0].slot == 0 && out[0].seq == 1 && t.WatchCount() == 0);
+    out.clear();
+    t.TakeForSubmit(P, out);
+    CHECK(out.empty()); // taken once
+
+    // two secondaries with jobs executed by one primary, in order
+    t.OnBegin(P, false);
+    t.OnBegin(X, true);
+    t.OnBegin(X2, true);
+    t.Watch(X, Job { 1, 2 });
+    t.Watch(X2, Job { 2, 3 });
+    const Handle both[2] = { X, X2 };
+    t.OnExecute(P, 2, both);
+    t.TakeForSubmit(P, out);
+    CHECK(out.size() == 2 && out[0].seq == 2 && out[1].seq == 3 && t.WatchCount() == 0);
+    out.clear();
+
+    // Evaluate on a primary that is inside a pass: the primary itself is watched
+    t.OnBegin(P2, false);
+    t.OnPass(P2, true);
+    t.Watch(P2, Job { 3, 4 });
+    t.OnPass(P2, false);
+    t.TakeForSubmit(P2, out);
+    CHECK(out.size() == 1 && out[0].seq == 4);
+    out.clear();
+
+    // the recording is abandoned (begun again before it was executed): the hook never gets the job
+    t.OnBegin(X, true);
+    t.Watch(X, Job { 0, 5 });
+    t.OnBegin(X, true);
+    CHECK(t.WatchCount() == 0);
+    t.OnExecute(P, 1, &X);
+    t.TakeForSubmit(P, out);
+    CHECK(out.empty());
+
+    // a job on a primary that is reset / freed / whose pool goes away
+    t.OnBegin(P, false);
+    t.Watch(P, Job { 1, 6 });
+    t.OnReset(P);
+    CHECK(t.WatchCount() == 0);
+    t.OnBegin(P, false);
+    t.Watch(P, Job { 1, 7 });
+    t.OnResetPool(pool);
+    CHECK(t.WatchCount() == 0);
+
+    // executing a secondary the tracker never saw, or a null list, is harmless
+    const Handle stranger = H(0xABC);
+    t.OnBegin(P, false);
+    t.Watch(P, Job { 2, 8 });
+    t.OnExecute(P, 1, &stranger);
+    t.OnExecute(P, 1, nullptr);
+    t.OnExecute(P, 1, &P); // self: ignored
+    t.TakeForSubmit(P, out);
+    CHECK(out.size() == 1 && out[0].seq == 8);
+}
+
+static void TestRing()
+{
+    Ring r;
+    bool dropped = false;
+
+    // round robin, sequence numbers
+    int a = r.Acquire(7, true, &dropped);
+    CHECK(a == 0 && !dropped && r.At(0).state == SlotState::Recording && r.At(0).seq == 1);
+    CHECK(r.Acquire(7, true) == 1);
+    r.Reset();
+    CHECK(r.Count(SlotState::Free) == Ring::Size && r.Seq() == 2);
+
+    // cancel puts the slot and the sequence back
+    a = r.Acquire(7, true);
+    const uint64_t seqA = r.At(a).seq;
+    r.Cancel(a);
+    CHECK(r.NextIndex() == a && r.Seq() == seqA - 1);
+    a = r.Acquire(7, true);
+    CHECK(r.At(a).seq == seqA);
+    r.Commit(a, true);
+    CHECK(r.IsReady(Job { a, seqA }) && r.At(a).clearFirst);
+    CHECK(!r.IsReady(Job { a, seqA + 1 }) && !r.IsReady(Job { -1, seqA }) && !r.IsReady(Job { 9, seqA }));
+
+    // stale rule: a hook job is not due at the next Evaluate, it is due at the one after
+    Job st[Ring::Size];
+    CHECK(r.Stale(st) == 0);
+    int b = r.Acquire(7, true);
+    r.Commit(b, false);
+    CHECK(r.Stale(st) == 1 && st[0].slot == a);
+    r.Submitted(a);
+    CHECK(!r.IsReady(Job { a, seqA }) && r.At(a).state == SlotState::InFlight);
+    r.Complete(a);
+    CHECK(r.At(a).state == SlotState::Free);
+
+    // a job no hook submits is due at the next Evaluate
+    r.Reset();
+    int c = r.Acquire(7, false);
+    r.Commit(c, false);
+    CHECK(r.Stale(st) == 1 && st[0].slot == c);
+
+    // ring full: the 5th acquire fails until the oldest completes
+    r.Reset();
+    int s[Ring::Size];
+    for (int i = 0; i < Ring::Size; i++)
+    {
+        s[i] = r.Acquire(1, true);
+        CHECK(s[i] == i);
+        r.Commit(s[i], false);
+        r.Submitted(s[i]);
+    }
+    CHECK(r.Acquire(1, true) == -1 && r.Count(SlotState::InFlight) == Ring::Size);
+    r.Complete(r.NextIndex());
+    CHECK(r.Acquire(1, true) == 0);
+
+    // a Ready job still in the next slot was never submitted: dropped and reported
+    r.Reset();
+    for (int i = 0; i < Ring::Size; i++)
+        r.Commit(r.Acquire(1, true), false);
+    dropped = false;
+    const uint64_t oldSeq = r.At(0).seq;
+    CHECK(r.Acquire(1, true, &dropped) == 0 && dropped);
+    CHECK(!r.IsReady(Job { 0, oldSeq })); // the old job can no longer be submitted
+
+    // a feature goes away: only its unsubmitted jobs are dropped
+    r.Reset();
+    int h1 = r.Acquire(1, true);
+    r.Commit(h1, false);
+    int h2 = r.Acquire(2, true);
+    r.Commit(h2, false);
+    int h3 = r.Acquire(1, true);
+    r.Commit(h3, false);
+    r.Submitted(h3);
+    CHECK(r.DropHandle(1) == 1);
+    CHECK(r.At(h1).state == SlotState::Free && r.At(h2).state == SlotState::Ready &&
+          r.At(h3).state == SlotState::InFlight);
+    CHECK(r.DropHandle(0xFFFFFFFFu) == 1 && r.At(h3).state == SlotState::InFlight);
+
+    // a failed submit frees the slot; state changes on the wrong state do nothing
+    r.Reset();
+    int f = r.Acquire(1, true);
+    r.Submitted(f); // not Ready
+    CHECK(r.At(f).state == SlotState::Recording);
+    r.Commit(f, false);
+    r.Complete(f); // not InFlight
+    CHECK(r.At(f).state == SlotState::Ready);
+    r.Fail(f);
+    CHECK(r.At(f).state == SlotState::Free);
+}
