+SGSR2FeatureVk::SGSR2FeatureVk(unsigned int InHandleId, NVSDK_NGX_Parameter* InParameters)
+    : SGSR2Feature(InHandleId, InParameters), IFeature_Vk(InHandleId, InParameters),
