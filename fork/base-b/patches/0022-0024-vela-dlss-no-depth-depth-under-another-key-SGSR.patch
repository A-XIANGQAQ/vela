From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 11:20:01 +0100
Subject: [PATCH 22/65] 0024-vela-dlss-no-depth: depth under another key, SGSR
 2 history off without depth, OPTI_VELA_NODEPTH test switch (VELA-PGEA74)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 6e3d95c977464cd631e97dc3b4ce533eabdc801c)
---
 OptiScaler/inputs/NVNGX_DLSS_Dx12.cpp       | 98 ++++++++++++++++++++-
 OptiScaler/upscalers/sgsr2/SGSR2Feature.cpp | 12 ++-
 OptiScaler/upscalers/sgsr2/SGSR2Feature.h   |  1 +
 3 files changed, 108 insertions(+), 3 deletions(-)

diff --git a/OptiScaler/inputs/NVNGX_DLSS_Dx12.cpp b/OptiScaler/inputs/NVNGX_DLSS_Dx12.cpp
index 25a439c8..89b53cc8 100644
--- a/OptiScaler/inputs/NVNGX_DLSS_Dx12.cpp
+++ b/OptiScaler/inputs/NVNGX_DLSS_Dx12.cpp
@@ -974,6 +974,85 @@ NVSDK_NGX_API NVSDK_NGX_Result NVSDK_NGX_D3D12_GetFeatureRequirements(
     return NVSDK_NGX_Result_FAIL_FeatureNotSupported;
 }
 
+// Vela 0.8.22 (0024, VELA-PGEA74 Clair Obscur): a DLSS context with no "Depth" (after the game's switch to DLSS: 1130x636 ->
+// 1920x1080, display-size motion vectors, depth -1). Absent, or under another key? Once per handle every pointer-valued key the
+// game set is logged, and a key with "depth" in its name holding a 2D texture in a depth format is used as the depth.
+// OPTI_VELA_NODEPTH=1 (test only) drops the game's depth instead, so the no-depth path can be run on any DLSS game.
+static bool VelaTestNoDepth()
+{
+    static const bool on = std::getenv("OPTI_VELA_NODEPTH") != nullptr;
+    return on;
+}
+
+static bool VelaIsDepthFormat(DXGI_FORMAT f)
+{
+    switch (f)
+    {
+    case DXGI_FORMAT_D32_FLOAT:
+    case DXGI_FORMAT_R32_TYPELESS:
+    case DXGI_FORMAT_R32_FLOAT:
+    case DXGI_FORMAT_D24_UNORM_S8_UINT:
+    case DXGI_FORMAT_R24G8_TYPELESS:
+    case DXGI_FORMAT_R24_UNORM_X8_TYPELESS:
+    case DXGI_FORMAT_D32_FLOAT_S8X24_UINT:
+    case DXGI_FORMAT_R32G8X24_TYPELESS:
+    case DXGI_FORMAT_R32_FLOAT_X8X24_TYPELESS:
+    case DXGI_FORMAT_D16_UNORM:
+    case DXGI_FORMAT_R16_TYPELESS:
+    case DXGI_FORMAT_R16_UNORM:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static ID3D12Resource* VelaDepthFromOtherKey(NVSDK_NGX_Parameter* params, unsigned int handleId, bool logKeys)
+{
+    auto* np = dynamic_cast<NVNGX_Parameters*>(params);
+    if (np == nullptr)
+    {
+        if (logKeys)
+            LOG_INFO("Vela depth: handle {0} has no '{1}' and its parameter object is not OptiScaler's: keys not listed",
+                     handleId, NVSDK_NGX_Parameter_Depth);
+        return nullptr;
+    }
+    std::string ptrKeys;
+    std::string foundKey;
+    ID3D12Resource* found = nullptr;
+    for (const auto& k : np->enumerate())
+    {
+        void* vp = nullptr;
+        if (np->Get(k.c_str(), &vp) != NVSDK_NGX_Result_Success || vp == nullptr)
+            continue; // not a pointer-valued key (Get leaves numbers out)
+        ptrKeys += (ptrKeys.empty() ? "" : ", ") + k;
+        if (found != nullptr || k == NVSDK_NGX_Parameter_Depth)
+            continue;
+        std::string lk = k;
+        for (auto& c : lk)
+            c = (char) tolower((unsigned char) c);
+        if (lk.find("depth") == std::string::npos)
+            continue; // only keys named as depth are read as resources: other pointers may be callbacks
+        auto* res = (ID3D12Resource*) vp;
+        const auto d = res->GetDesc();
+        if (d.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D && VelaIsDepthFormat(d.Format))
+        {
+            found = res;
+            foundKey = k + " (" + std::to_string(d.Width) + "x" + std::to_string(d.Height) + " fmt " +
+                       std::to_string((int) d.Format) + ")";
+        }
+    }
+    if (logKeys)
+    {
+        LOG_INFO("Vela depth: handle {0} has no '{1}'; pointer keys the game set: {2}", handleId,
+                 NVSDK_NGX_Parameter_Depth, ptrKeys.empty() ? std::string("none") : ptrKeys);
+        if (found != nullptr)
+            LOG_INFO("Vela depth: handle {0}: depth found under {1}: used as the depth", handleId, foundKey);
+        else
+            LOG_INFO("Vela depth: handle {0}: no depth under any key: the context has no depth", handleId);
+    }
+    return found;
+}
+
 static NVSDK_NGX_Result TryEvaluateOptiFeature(ID3D12GraphicsCommandList* InCmdList,
                                                const NVSDK_NGX_Handle* InFeatureHandle,
                                                NVSDK_NGX_Parameter* InParameters,
@@ -1091,12 +1170,27 @@ static NVSDK_NGX_Result TryEvaluateOptiFeature(ID3D12GraphicsCommandList* InCmdL
         // FSR 4. SGSR 2 for this handle only, the game's other contexts still try FSR 4. Read every frame: a handle that
         // gets depth later goes to FSR 4, inside the limit on tries below
         bool noDepth = false;
-        if (isFsr4 && !fsr4Down)
         {
+            // 0024: for every model (SGSR 2 without depth ghosts too): the test switch, then a depth under another key
+            static ankerl::unordered_dense::set<unsigned int> velaDepthListed;
             ID3D12Resource* velaDepth = nullptr;
             if (InParameters->Get(NVSDK_NGX_Parameter_Depth, &velaDepth) != NVSDK_NGX_Result_Success)
                 InParameters->Get(NVSDK_NGX_Parameter_Depth, (void**) &velaDepth);
-            noDepth = velaDepth == nullptr;
+            if (VelaTestNoDepth())
+            {
+                if (velaDepthListed.insert(handleId).second)
+                    LOG_WARN("Vela depth: OPTI_VELA_NODEPTH=1 (test only): handle {0} gets no depth", handleId);
+                if (velaDepth != nullptr)
+                    InParameters->Set(NVSDK_NGX_Parameter_Depth, (ID3D12Resource*) nullptr);
+                velaDepth = nullptr;
+            }
+            else if (velaDepth == nullptr)
+            {
+                velaDepth = VelaDepthFromOtherKey(InParameters, handleId, velaDepthListed.insert(handleId).second);
+                if (velaDepth != nullptr)
+                    InParameters->Set(NVSDK_NGX_Parameter_Depth, velaDepth);
+            }
+            noDepth = isFsr4 && !fsr4Down && velaDepth == nullptr;
         }
         const Upscaler iniUp = cfg.Dx12Upscaler.value_or_default();
         const Upscaler want = m == VelaLive::Model::Sgsr2 || fsr4Down || noDepth ? Upscaler::SGSR2
diff --git a/OptiScaler/upscalers/sgsr2/SGSR2Feature.cpp b/OptiScaler/upscalers/sgsr2/SGSR2Feature.cpp
index 0d56e0f9..7e38e361 100644
--- a/OptiScaler/upscalers/sgsr2/SGSR2Feature.cpp
+++ b/OptiScaler/upscalers/sgsr2/SGSR2Feature.cpp
@@ -147,7 +147,17 @@ bool SGSR2Feature::UpdateSharedConstants(NVSDK_NGX_Parameter* InParameters)
 
     int reset = 0;
     InParameters->Get(NVSDK_NGX_Parameter_Reset, &reset);
-    _constants.reset = (reset != 0 || !_historyValid) ? 1u : 0u;
+    // Vela 0.8.22 (0024, VELA-PGEA74): without depth there is no disocclusion test, and the history ghosts behind every
+    // moving edge. History off every frame instead: the current frame alone (kernelfactor and alpha 1 in the shader), a
+    // softer picture with no ghosting. OPTI_VELA_NODEPTH_HISTORY=1 keeps the history (the old behaviour).
+    static const bool keepHistoryNoDepth = std::getenv("OPTI_VELA_NODEPTH_HISTORY") != nullptr;
+    const bool noDepthNoHistory = _constants.hasDepth == 0 && !keepHistoryNoDepth;
+    if (noDepthNoHistory && !_loggedNoHistory)
+    {
+        _loggedNoHistory = true;
+        LOG_INFO("Vela: SGSR 2 without depth: history off every frame (no ghosting, a softer picture)");
+    }
+    _constants.reset = (reset != 0 || !_historyValid || noDepthNoHistory) ? 1u : 0u;
 
 
     return true;
diff --git a/OptiScaler/upscalers/sgsr2/SGSR2Feature.h b/OptiScaler/upscalers/sgsr2/SGSR2Feature.h
index 38075263..145f60c6 100644
--- a/OptiScaler/upscalers/sgsr2/SGSR2Feature.h
+++ b/OptiScaler/upscalers/sgsr2/SGSR2Feature.h
@@ -71,6 +71,7 @@ class SGSR2Feature : public virtual IFeature
     // Whether a usable previous frame exists. Drives the reset flag, which the
     // shared constants set, so it lives here rather than in either backend.
     bool _historyValid = false;
+    bool _loggedNoHistory = false; // 0024: the no-depth history-off line, once
 
     // Fills _constants from the NGX parameters. API-independent; each backend
     // uploads the result itself.
-- 
