     }
 }
+
+// ------------------------------------------------------------------------------------------ 0045: Unity's interface
+// Own declarations of the public Unity native plugin API (IUnityInterface.h, IUnityGraphicsVulkan.h), only what is used.
+// IUnityInterfaces = { GetInterface, RegisterInterface, GetInterfaceSplit, RegisterInterfaceSplit }.
+// IUnityGraphicsVulkan (V1 GUID 95355348d4ef4e11-9789313dfcffcc87; V2 has the same first 13 members): slot 2
+// ConfigureEvent (the plugin's own CALL [RAX+10h]), slot 4 CommandRecordingState, slot 9 EnsureOutsideRenderPass.
+constexpr unsigned long long kVulkanGuidHigh = 0x95355348d4ef4e11ULL;
+constexpr unsigned long long kVulkanGuidLow = 0x9789313dfcffcc87ULL;
+constexpr int kSlotGetInterfaceSplit = 2;
+constexpr int kSlotConfigureEvent = 2;
+constexpr int kSlotCommandRecordingState = 4;
+constexpr int kSlotEnsureOutsideRenderPass = 9;
+constexpr int kVulkanSlotsNeeded = 10;
+
+struct UnityRecordingState // UnityVulkanRecordingState
+{
+    VkCommandBuffer commandBuffer;
+    VkCommandBufferLevel commandBufferLevel;
+    VkRenderPass renderPass;
+    VkFramebuffer framebuffer;
+    int subPassIndex;
+    unsigned long long currentFrameNumber;
+    unsigned long long safeFrameNumber;
+    void* reserved[4];
+};
+
+struct UnityEventConfig // UnityVulkanPluginEventConfig
+{
+    int renderPassPrecondition; // 2 = kUnityVulkanRenderPass_EnsureOutside
+    int graphicsQueueAccess;    // 0 = kUnityVulkanGraphicsQueueAccess_DontCare
+    uint32_t flags;             // 9 = EnsurePreviousFrameSubmission | ModifiesCommandBuffersState (the plugin's own)
+};
+
+using PFN_GetInterfaceSplit = void* (*) (unsigned long long, unsigned long long);
+using PFN_ConfigureEvent = void (*)(int, const UnityEventConfig*);
+using PFN_CommandRecordingState = bool (*)(UnityRecordingState*, int);
+using PFN_EnsureOutsideRenderPass = void (*)();
+using PFN_GetBaseEventId = int (*)();
+
+void** g_vulkan = nullptr; // IUnityGraphicsVulkan as its table of function pointers; set once, under g_mx
+int g_ifaceTries = 0;
+bool g_configuredAtRecord = false;
+bool g_firstLogged[2] = {};
+uint64_t g_evals = 0, g_insideAtEntry = 0, g_outsideAfter = 0, g_stillInside = 0, g_stateFailed = 0, g_changed = 0;
+
+bool Readable(const void* p, size_t size)
+{
+    MEMORY_BASIC_INFORMATION mbi {};
+    if (p == nullptr || VirtualQuery(p, &mbi, sizeof(mbi)) == 0)
+        return false;
+    if (mbi.State != MEM_COMMIT || (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) != 0)
+        return false;
+    const auto* end = static_cast<const uint8_t*>(mbi.BaseAddress) + mbi.RegionSize;
+    return static_cast<const uint8_t*>(p) + size <= end;
+}
+
+bool InModule(const void* p, HMODULE module)
+{
+    auto* base = reinterpret_cast<uint8_t*>(module);
+    const uint32_t size = ImageSize(base);
+    const auto* q = static_cast<const uint8_t*>(p);
+    return size != 0 && q >= base && q < base + size;
+}
+
+// g_mx held. One line per failure; at most three tries (NGX init, first CreateFeature, first Evaluate).
+bool FindInterface(const char* where)
+{
+    if (g_vulkan != nullptr)
+        return true;
+    if (g_ifaceTries >= 3)
+        return false;
+    g_ifaceTries++;
+
+    HMODULE plugin = GetModuleHandleW(L"NVUnityPlugin.dll");
+    HMODULE player = GetModuleHandleW(L"UnityPlayer.dll");
+    if (plugin == nullptr || player == nullptr)
+    {
+        LOG_INFO("Vela Unity VK: interface not looked for at {}: {} is not loaded (not a Unity game with the NVIDIA "
+                 "plugin)",
+                 where, plugin == nullptr ? "NVUnityPlugin.dll" : "UnityPlayer.dll");
+        g_ifaceTries = 3;
+        return false;
+    }
+
+    auto* pluginBase = reinterpret_cast<uint8_t*>(plugin);
+    auto* load = reinterpret_cast<uint8_t*>(GetProcAddress(plugin, "UnityPluginLoad"));
+    if (load == nullptr || !Readable(load, 16))
+    {
+        LOG_WARN("Vela Unity VK: interface not found at {}: NVUnityPlugin.dll exports no UnityPluginLoad", where);
+        return false;
+    }
+    uint8_t* fn = FollowJumps(load, pluginBase);
+    uint8_t* global = fn != nullptr && Readable(fn, kStoreWindow) ? FirstRipStore64(fn, kStoreWindow) : nullptr;
+    if (global == nullptr || !InModule(global, plugin) || !Readable(global, sizeof(void*)))
+    {
+        LOG_WARN("Vela Unity VK: interface not found at {}: no store of IUnityInterfaces* in the first {} bytes of "
+                 "UnityPluginLoad (another plugin build)",
+                 where, kStoreWindow);
+        return false;
+    }
+
+    void** interfaces = *reinterpret_cast<void***>(global);
+    if (interfaces == nullptr || !Readable(interfaces, 4 * sizeof(void*)) || !InModule(interfaces[0], player) ||
+        !InModule(interfaces[1], player) || !InModule(interfaces[2], player) || !InModule(interfaces[3], player))
+    {
+        LOG_WARN("Vela Unity VK: interface not found at {}: the plugin's global (RVA {:X}) holds {:X}, not an "
+                 "IUnityInterfaces of UnityPlayer.dll",
+                 where, (size_t) (global - pluginBase), (size_t) interfaces);
+        return false;
+    }
+
+    auto getSplit = reinterpret_cast<PFN_GetInterfaceSplit>(interfaces[kSlotGetInterfaceSplit]);
+    void** vulkan = static_cast<void**>(getSplit(kVulkanGuidHigh, kVulkanGuidLow));
+    if (vulkan == nullptr || !Readable(vulkan, kVulkanSlotsNeeded * sizeof(void*)) ||
+        !InModule(vulkan[kSlotConfigureEvent], player) || !InModule(vulkan[kSlotCommandRecordingState], player) ||
+        !InModule(vulkan[kSlotEnsureOutsideRenderPass], player))
+    {
+        LOG_WARN("Vela Unity VK: interface not found at {}: IUnityInterfaces {:X} gave IUnityGraphicsVulkan {:X} (null "
+                 "= Unity does not run Vulkan; else its functions are not in UnityPlayer.dll)",
+                 where, (size_t) interfaces, (size_t) vulkan);
+        return false;
+    }
+
+    g_vulkan = vulkan;
+    LOG_INFO("Vela Unity VK: interface found at {}: IUnityInterfaces {:X} (the plugin's global at RVA {:X}), "
+             "IUnityGraphicsVulkan {:X} (V1 GUID 95355348d4ef4e11-9789313dfcffcc87); VELA_UNITY_VK_OUTSIDE={}",
+             where, (size_t) interfaces, (size_t) (global - pluginBase), (size_t) vulkan, Flags());
+    return true;
+}
+
+// g_mx held, interface found. Unity's header: "should be called during initialization"; whether a later call is
+// honoured is what the device run tells.
+void ConfigureEvents(const char* where)
+{
+    HMODULE plugin = GetModuleHandleW(L"NVUnityPlugin.dll");
+    auto getBase = plugin != nullptr ? reinterpret_cast<PFN_GetBaseEventId>(GetProcAddress(plugin, "NVUP_GetBaseEventId"))
+                                     : nullptr;
+    if (getBase == nullptr)
+    {
+        LOG_WARN("Vela Unity VK: ConfigureEvent not called at {}: NVUnityPlugin.dll exports no NVUP_GetBaseEventId",
+                 where);
+        return;
+    }
+    const int base = getBase();
+    const UnityEventConfig cfg { 2, 0, 9 };
+    auto configure = reinterpret_cast<PFN_ConfigureEvent>(g_vulkan[kSlotConfigureEvent]);
+    configure(base + 1, &cfg);
+    configure(base + 2, &cfg);
+    LOG_INFO("Vela Unity VK: ConfigureEvent called for events {} and {} at {} (render pass precondition "
+             "EnsureOutside, queue access DontCare, flags 9)",
+             base + 1, base + 2, where);
+}
 } // namespace
 
 HMODULE VelaUnityVk::AfterLoad(std::wstring_view name, HMODULE module, const char* where)
@@ -122,3 +277,90 @@ void VelaUnityVk::CheckLoaded(const char* where)
 }
 
 bool VelaUnityVk::OutsidePass() { return g_outside.load(std::memory_order_relaxed); }
+
+void VelaUnityVk::AtNgxInit()
+{
+    if ((Flags() & 6) == 0)
+    {
+        LOG_INFO("Vela Unity VK: interface not used (VELA_UNITY_VK_OUTSIDE={}, bits 2 and 4 not set)", Flags());
+        return;
+    }
+    std::scoped_lock lock(g_mx);
+    if (FindInterface("NVSDK_NGX_VULKAN_Init") && (Flags() & 2) != 0)
+        ConfigureEvents("NVSDK_NGX_VULKAN_Init");
+}
+
+VkCommandBuffer VelaUnityVk::BeforeRecord(VkCommandBuffer given, bool evaluate, PassState* state)
+{
+    if (state != nullptr)
+        *state = PassState::Unknown;
+    if ((Flags() & 6) == 0)
+        return given;
+
+    const char* what = evaluate ? "Evaluate" : "CreateFeature";
+    std::scoped_lock lock(g_mx);
+    if (!FindInterface(what))
+        return given;
+
+    // the plugin's own ConfigureEvent (EnsureInside) may have come after ours at NGX init: once more, now
+    if ((Flags() & 2) != 0 && !g_configuredAtRecord)
+    {
+        g_configuredAtRecord = true;
+        ConfigureEvents(what);
+    }
+    if ((Flags() & 4) == 0)
+        return given;
+
+    auto recordingState = reinterpret_cast<PFN_CommandRecordingState>(g_vulkan[kSlotCommandRecordingState]);
+    auto ensureOutside = reinterpret_cast<PFN_EnsureOutsideRenderPass>(g_vulkan[kSlotEnsureOutsideRenderPass]);
+
+    VkCommandBuffer cmd = given;
+    UnityRecordingState st {};
+    bool ok = recordingState(&st, 0);
+    const bool insideAtEntry = ok && st.renderPass != VK_NULL_HANDLE;
+    const int levelAtEntry = (int) st.commandBufferLevel;
+    const VkCommandBuffer unityAtEntry = st.commandBuffer;
+    bool insideAfter = insideAtEntry;
+    if (insideAtEntry)
+    {
+        ensureOutside();
+        st = {};
+        ok = recordingState(&st, 0);
+        insideAfter = ok && st.renderPass != VK_NULL_HANDLE;
+        if (ok && !insideAfter && st.commandBuffer != VK_NULL_HANDLE)
+            cmd = st.commandBuffer; // Unity ended the pass: its current command buffer is the one outside it
+    }
+
+    if (evaluate)
+    {
+        g_evals++;
+        g_insideAtEntry += insideAtEntry ? 1 : 0;
+        g_stateFailed += ok ? 0 : 1;
+        g_outsideAfter += ok && insideAtEntry && !insideAfter ? 1 : 0;
+        g_stillInside += ok && insideAfter ? 1 : 0;
+        g_changed += cmd != given ? 1 : 0;
+    }
+    if (!g_firstLogged[evaluate ? 1 : 0])
+    {
+        g_firstLogged[evaluate ? 1 : 0] = true;
+        if (!ok)
+            LOG_WARN("Vela Unity VK: first {}: CommandRecordingState failed ({}); recording into the command buffer NGX "
+                     "was given",
+                     what, insideAtEntry ? "after EnsureOutsideRenderPass" : "at entry");
+        else
+            LOG_INFO("Vela Unity VK: first {}: render pass at entry {} (level {}, Unity's command buffer {:X}, NGX was "
+                     "given {:X}), after EnsureOutsideRenderPass {}, command buffer changed {} (recording into {:X})",
+                     what, insideAtEntry ? "yes" : "no", levelAtEntry == 0 ? "primary" : "secondary",
+                     (size_t) unityAtEntry, (size_t) given,
+                     !insideAtEntry ? "not called" : insideAfter ? "still inside" : "outside", cmd != given ? "yes" : "no",
+                     (size_t) cmd);
+    }
+    if (evaluate && g_evals % 600 == 0)
+        LOG_INFO("Vela Unity VK: {} Evaluate calls: inside a render pass at entry {}, outside after "
+                 "EnsureOutsideRenderPass {}, still inside {}, state call failed {}, command buffer changed {}",
+                 g_evals, g_insideAtEntry, g_outsideAfter, g_stillInside, g_stateFailed, g_changed);
+
+    if (state != nullptr && ok)
+        *state = insideAfter ? PassState::Inside : PassState::Outside;
+    return ok ? cmd : given;
+}
