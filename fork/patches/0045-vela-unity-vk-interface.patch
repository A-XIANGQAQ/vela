-// INSIDE a render pass (IUnityGraphicsVulkan::ConfigureEvent, renderPassPrecondition = 1). In process, right after the
-// module is loaded and before any of its code ran, that one immediate becomes 2 (EnsureOutside): Evaluate then gets a
-// command buffer outside any render pass and the upscale records into it, in the same frame (no 0043 deferral).
-// The scan and the change: hooks/VelaUnityVkCore.h.
+// Vela 0044 / 0045 (unity-vk-outside-pass): Unity's NVIDIA plugin (NVUnityPlugin.dll) asks Unity to call its DLSS
+// events INSIDE a render pass (IUnityGraphicsVulkan::ConfigureEvent, renderPassPrecondition = 1), where a compute
+// upscaler cannot record. Three ways out, one bit each:
 //
-//   VELA_UNITY_VK_OUTSIDE   0 = off; unset / 1 = on
+//   VELA_UNITY_VK_OUTSIDE   bit flags, a digit 0..7, unset = 7
+//     1  0044: right after NVUnityPlugin.dll is loaded, that one immediate in its code becomes 2 (EnsureOutside).
+//        Works only when OptiScaler is loaded before the plugin's device init (device job R8D: it was not).
+//     2  0045: at NVSDK_NGX_VULKAN_Init, and once more before the first recording, call Unity's own
+//        ConfigureEvent(NVUP_GetBaseEventId() + 1 and + 2, { EnsureOutside, DontCare, 9 }).
+//     4  0045: before NGX CreateFeature / Evaluate record anything, ask Unity (CommandRecordingState); inside a render
+//        pass: EnsureOutsideRenderPass(), ask again, and record into the command buffer Unity then names.
+//
+// Unity's interface is reached through the plugin itself: its export UnityPluginLoad stores the IUnityInterfaces* it
+// was given in a global; that store is decoded from the code (hooks/VelaUnityVkCore.h) and the IUnityGraphicsVulkan
+// (V1 GUID) taken from it. Every pointer is checked to lie inside UnityPlayer.dll before it is called.
 //
 // Log lines start with "Vela Unity VK:".
 
 #include <pch.h>
 
+#include <vulkan/vulkan.hpp>
+
 #include <string_view>
 
 namespace VelaUnityVk
@@ -26,4 +36,18 @@ void CheckLoaded(const char* where);
 // hook, or found already "outside". A change made to a module that was already loaded may be too late for this run
 // (the precondition is read once, at the plugin's device init) and does not count.
 bool OutsidePass();
+
+// NVSDK_NGX_VULKAN_Init: finds Unity's interface and (bit 2) calls ConfigureEvent.
+void AtNgxInit();
+
+enum class PassState : int
+{
+    Unknown = 0, // no interface, bit 4 off, or Unity's state call failed
+    Outside = 1, // Unity says: no render pass is active on the command buffer returned
+    Inside = 2   // still inside a render pass after EnsureOutsideRenderPass
+};
+
+// Before NGX CreateFeature / Evaluate record into the game's command buffer, on the thread of that call. Returns the
+// command buffer to record into: `given`, or Unity's current one when EnsureOutsideRenderPass moved the recording.
+VkCommandBuffer BeforeRecord(VkCommandBuffer given, bool evaluate, PassState* state);
 } // namespace VelaUnityVk
diff --git a/OptiScaler/hooks/VelaUnityVkCore.h b/OptiScaler/hooks/VelaUnityVkCore.h
index 23ea56b..b92152a 100644
--- a/OptiScaler/hooks/VelaUnityVkCore.h
+++ b/OptiScaler/hooks/VelaUnityVkCore.h
@@ -140,4 +140,51 @@ inline PatchResult Patch(uint8_t* base, uint32_t* rva, int* hits)
     FlushInstructionCache(GetCurrentProcess(), s.at, kSigSize);
     return PatchResult::Patched;
 }
+
+// ---- Vela 0045: where the plugin keeps the IUnityInterfaces* it was given in UnityPluginLoad
+constexpr size_t kStoreWindow = 0x80;
+
+inline uint32_t ImageSize(const uint8_t* base)
+{
+    if (base == nullptr)
+        return 0;
+    const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
+    if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew <= 0 || dos->e_lfanew > 0x1000)
+        return 0;
+    const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(base + dos->e_lfanew);
+    return nt->Signature == IMAGE_NT_SIGNATURE ? nt->OptionalHeader.SizeOfImage : 0;
+}
+
+// An export of a debug / incremental-link build is an `E9 rel32` jump thunk; follow up to four, staying in the image.
+inline uint8_t* FollowJumps(uint8_t* p, const uint8_t* imageBase)
+{
+    const uint32_t size = ImageSize(imageBase);
+    for (int i = 0; i < 4 && p != nullptr && p[0] == 0xE9; i++)
+    {
+        int32_t rel = 0;
+        std::memcpy(&rel, p + 1, 4);
+        uint8_t* next = p + 5 + rel;
+        if (size == 0 || next < imageBase || next + kStoreWindow > imageBase + size)
+            return nullptr;
+        p = next;
+    }
+    return p;
+}
+
+// The first RIP-relative 64-bit store in [fn, fn + window): REX.W (48 or 4C) 89 /r with mod = 00, rm = 101, i.e.
+// `mov [rip + disp32], r64`. Returns the address stored to.
+inline uint8_t* FirstRipStore64(uint8_t* fn, size_t window)
+{
+    if (fn == nullptr)
+        return nullptr;
+    for (size_t i = 0; i + 7 <= window; i++)
+    {
+        if ((fn[i] != 0x48 && fn[i] != 0x4C) || fn[i + 1] != 0x89 || (fn[i + 2] & 0xC7) != 0x05)
+            continue;
+        int32_t disp = 0;
+        std::memcpy(&disp, fn + i + 3, 4);
+        return fn + i + 7 + disp;
+    }
+    return nullptr;
+}
 } // namespace vela_unity_vk
