diff --git a/OptiScaler/inputs/FSR3_Dx12.cpp b/OptiScaler/inputs/FSR3_Dx12.cpp
index 05026fa..0bc40db 100644
--- a/OptiScaler/inputs/FSR3_Dx12.cpp
+++ b/OptiScaler/inputs/FSR3_Dx12.cpp
@@ -307,7 +307,7 @@ static Fsr3::FfxErrorCode ffxFsr3ContextDispatch_Dx12(Fsr3::FfxFsr3UpscalerConte
