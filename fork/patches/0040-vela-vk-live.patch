 }
 
+// Vela 0040: the upscaler versions a provider module offers (ffxQuery GET_VERSIONS), into State as QueryVersionsVulkan
+static void VelaQueryVersionsVk(PfnFfxQuery query)
+{
+    ffxQueryDescGetVersions versionQuery {};
+    versionQuery.header.type = FFX_API_QUERY_DESC_TYPE_GET_VERSIONS;
+    versionQuery.createDescType = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+    uint64_t versionCount = 0;
+    versionQuery.outputCount = &versionCount;
+    query(nullptr, &versionQuery.header);
+    State::Instance().ffxUpscalerVersionIds.resize(versionCount);
+    State::Instance().ffxUpscalerVersionNames.resize(versionCount);
+    versionQuery.versionIds = State::Instance().ffxUpscalerVersionIds.data();
+    versionQuery.versionNames = State::Instance().ffxUpscalerVersionNames.data();
+    query(nullptr, &versionQuery.header);
+}
+
 bool FFXFeatureVk::InitFFX(const NVSDK_NGX_Parameter* InParameters)
 {
     LOG_DEBUG("FFXFeatureVk::InitFFX");
@@ -147,10 +170,84 @@ bool FFXFeatureVk::InitFFX(const NVSDK_NGX_Parameter* InParameters)
         return false;
     }
 
+    // Vela 0040 (as 0036 in DX12): live model dittosr -- the context comes from DittoSR's own module
+    // (FfxApiProxy::InitDittoSRVk); when it cannot load or make the context, FSR 3 (AMD's amd_fidelityfx_vk.dll) as for
+    // fsr3, with one "cannot run" line
+    const VelaLive::Model velaModel = VelaLive::Poll().model;
+    bool ditto = velaModel == VelaLive::Model::DittoSR;
+    if (ditto && !FfxApiProxy::InitDittoSRVk())
+    {
+        LOG_WARN("Vela live: dittosr cannot run in this game ({}: {}); FSR 3 instead",
+                 wstring_to_string(FfxApiProxy::DittoSRVk_Path()), FfxApiProxy::DittoSRVk_Why());
+        ditto = false;
+    }
+    const bool amdReady = FfxApiProxy::VULKAN_CreateContext() != nullptr && FfxApiProxy::VULKAN_Query() != nullptr;
+    if (!ditto && !amdReady)
+    {
+        LOG_ERROR("Vela: no amd_fidelityfx_vk.dll for FSR 3 on Vulkan");
+        return false;
+    }
+
+    for (;;)
     {
         ScopedSkipSpoofingGlobal skipSpoofingGlobal {};
+        _ditto = ditto;
+
+        if (ditto)
+            VelaQueryVersionsVk(FfxApiProxy::DittoSRVk_Query());
+        else
+            QueryVersionsVulkan();
+
+        auto& names = State::Instance().ffxUpscalerVersionNames;
+        {
+            std::string all;
+            for (size_t i = 0; i < names.size(); i++)
+                all += (i ? ", " : "") + std::to_string(i) + "=" + std::string(names[i] != nullptr ? names[i] : "");
+            LOG_INFO("Vela: FFX upscaler versions (Vulkan{}): {}", ditto ? ", DittoSR" : "", all);
+        }
 
-        QueryVersionsVulkan();
+        if (ditto)
+        {
+            // DittoSR's upscaler (the version named DittoSR, else its first)
+            int pick = names.empty() ? -1 : 0;
+            for (size_t i = 0; i < names.size(); i++)
+                if (names[i] != nullptr && std::string(names[i]).find("DittoSR") != std::string::npos)
+                {
+                    pick = (int) i;
+                    break;
+                }
+            if (pick < 0)
+            {
+                LOG_WARN("Vela live: dittosr cannot run in this game ({}: no upscaler version); FSR 3 instead",
+                         wstring_to_string(FfxApiProxy::DittoSRVk_Path()));
+                ditto = false;
+                if (!amdReady)
+                    return false;
+                continue;
+            }
+            Config::Instance()->FfxUpscalerIndex.set_volatile_value(pick);
+            LOG_INFO("Vela: FFX upscaler index {} ({}) for DittoSR", pick, names[pick] != nullptr ? names[pick] : "");
+        }
+        // Vela live model fsr3: FSR 3.1 -- the newest 3.x upscaler the FidelityFX DLL offers; also dittosr that could
+        // not run
+        else if (VelaLive::IsFfx(velaModel))
+        {
+            int best3 = -1;
+            for (size_t i = 0; i < names.size(); i++)
+            {
+                const std::string n = names[i] != nullptr ? names[i] : "";
+                if (n.rfind("3.", 0) == 0 &&
+                    (best3 < 0 || n > std::string(names[best3] != nullptr ? names[best3] : "")))
+                    best3 = (int) i;
+            }
+            if (best3 >= 0)
+            {
+                Config::Instance()->FfxUpscalerIndex.set_volatile_value(best3);
+                LOG_INFO("Vela: FFX upscaler index {} ({}) for FSR 3", best3, names[best3]);
+            }
+            else
+                LOG_WARN("Vela: FSR 3 asked, the FidelityFX DLL offers no 3.x upscaler");
+        }
 
         InitFlags();
 
@@ -166,6 +263,12 @@ bool FFXFeatureVk::InitFFX(const NVSDK_NGX_Parameter* InParameters)
 
         _contextDesc.header.pNext = &backendDesc.header;
 
+        if (State::Instance().ffxUpscalerVersionIds.empty())
+        {
