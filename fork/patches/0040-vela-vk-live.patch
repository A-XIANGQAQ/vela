+++ b/OptiScaler/upscalers/ffx/FFXFeature_Vk.cpp
@@ -2,6 +2,7 @@
 #include <Config.h>
 #include <Util.h>
 #include <proxies/FfxApi_Proxy.h>
+#include <upscalers/sgsr3/VelaLive.h>
 #include "FFXFeature_Vk.h"
 #include "nvsdk_ngx_vk.h"
 #include "MathUtils.h"
@@ -125,12 +126,34 @@ FFXFeatureVk::FFXFeatureVk(unsigned int InHandleId, NVSDK_NGX_Parameter* InParam
 {
     _moduleLoaded = FfxApiProxy::InitFfxVk();
 
-    if (_moduleLoaded)
+    // Vela 0040: the live model dittosr needs only DittoSR's own module
+    if (!_moduleLoaded && VelaLive::Poll().model == VelaLive::Model::DittoSR && FfxApiProxy::InitDittoSRVk())
