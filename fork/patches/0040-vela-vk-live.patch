From b4b4768278cfdac9da3a4ee7d27bf2e29d3c9bc3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 15:14:20 +0100
Subject: [PATCH] 0040-vela-vk-live: Vela live models in native Vulkan games,
 as in DX12/DX11: NVNGX_DLSS_Vk.cpp polls VelaLive (the same
 Z:\tmp\vela-live\<appid>.ini) per handle and re-creates the upscaler on a
 model change -- sgsr2 = SGSR 2 (Vulkan), fsr3 = FSR 3.1 on the FFX backend
 (AMD's amd_fidelityfx_vk.dll, the newest 3.x upscaler it offers), dittosr =
 DittoSR on the FFX backend through a module of its own
 (FfxApiProxy::InitDittoSRVk: VELA_DITTOSR_DIR or <OptiScaler's DLL
 folder>\dittosr\amd_fidelityfx_upscaler_vk.dll, else the DX12-named
 amd_fidelityfx_upscaler_dx12.dll, the same DittoSR 0.5.4 binary; loaded once,
 never hooked; FSR 3 with a "cannot run" line when it cannot load or make its
 context), fsr4 / fsr4fast / fsr4lite = SGSR 2 with one line "cannot run in
 this Vulkan game yet", no live file = the ini's VulkanUpscaler; a backend
 that does not take is tried twice per model; SGSR 2 is re-created at the
 game's subrect (live change, or a subrect held 30 frames) and takes it in
 Init; each handle logs once the colour / depth / MV / output VkFormats the
 game hands

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 OptiScaler/inputs/NVNGX_DLSS_Vk.cpp            | 120 +++++++++++++++++++
 OptiScaler/proxies/FfxApi_Proxy.h              | 104 +++++++++++++++++
 OptiScaler/upscalers/ffx/FFXFeature_Vk.cpp     | 154 ++++++++++++++++++++++---
 OptiScaler/upscalers/ffx/FFXFeature_Vk.h       |  21 +++-
 OptiScaler/upscalers/sgsr2/SGSR2Feature_Vk.cpp |   4 +
 5 files changed, 388 insertions(+), 15 deletions(-)

diff --git a/OptiScaler/inputs/NVNGX_DLSS_Vk.cpp b/OptiScaler/inputs/NVNGX_DLSS_Vk.cpp
index 136f072..63c9c28 100644
--- a/OptiScaler/inputs/NVNGX_DLSS_Vk.cpp
+++ b/OptiScaler/inputs/NVNGX_DLSS_Vk.cpp
@@ -16,6 +16,8 @@
 #include <ankerl/unordered_dense.h>
 #include <imgui/ImGuiNotify.hpp>
 #include <misc/IdentifyGpu.h>
+#include "nvsdk_ngx_vk.h"
+#include <upscalers/sgsr3/VelaLive.h>
 
 VkInstance vkInstance;
 VkPhysicalDevice vkPD;
@@ -1047,6 +1049,124 @@ NVSDK_NGX_API NVSDK_NGX_Result NVSDK_NGX_VULKAN_EvaluateFeature(VkCommandBuffer
     IFeature_Vk* deviceContext = nullptr;
     auto contextData = &VkContexts[handleId];
 
+    // Vela 0040: live models in a native Vulkan game (as NVNGX_DLSS_Dx12.cpp, upscalers/sgsr3/VelaLive.h): the panel's
+    // model re-creates each handle's upscaler -- sgsr2 = SGSR 2 (Vulkan), fsr3 = FSR 3.1 on the FFX backend (AMD's
+    // amd_fidelityfx_vk.dll), dittosr = DittoSR on the same backend through its own module (FFXFeature_Vk.cpp, FSR 3
+    // when it cannot run), fsr4 / fsr4fast / fsr4lite = SGSR 2 with one line (no FSR 4 on Vulkan yet), no live file =
+    // the ini's VulkanUpscaler. A new handle of the wrong backend switches on its first frame, a model change re-creates
+    // every handle once, and a backend that keeps failing is tried at most twice per model.
+    if (contextData->feature != nullptr && !state.changeBackend[handleId])
+    {
+        auto* feature = contextData->feature.get();
+        struct VelaHandleVk
+        {
+            VelaLive::Model model = VelaLive::Model::Unset;
+            int tries = 0;
+            bool formatsLogged = false;
+        };
+        static ankerl::unordered_dense::map<unsigned int, VelaHandleVk> velaHandles;
+        const VelaLive::Model m = VelaLive::Poll().model;
+        static VelaLive::Model lastModel = VelaLive::Model::Unset;
+        static bool fsr4Logged = false;
+        if (m != lastModel)
+        {
+            fsr4Logged = false;
+            lastModel = m;
+        }
+        const bool isFsr4 = VelaLive::IsFsr4Full(m) || m == VelaLive::Model::Fsr4Lite;
+        if (isFsr4 && !fsr4Logged)
+        {
+            fsr4Logged = true;
+            LOG_WARN("Vela live: {0} cannot run in this Vulkan game yet; SGSR 2 instead", VelaLive::ModelName(m));
+        }
+        const Upscaler iniUp = Config::Instance()->VulkanUpscaler.value_or_default();
+        const Upscaler want = m == VelaLive::Model::Sgsr2 || isFsr4 ? Upscaler::SGSR2
+                              : VelaLive::IsFfx(m)                  ? Upscaler::FFX // fsr3 and dittosr
+                              : iniUp == Upscaler::SGSR3            ? Upscaler::SGSR2
+                                                                    : iniUp;
+        const bool seen = velaHandles.contains(handleId);
+        auto& h = velaHandles[handleId];
+        if (!h.formatsLogged)
+        {
+            // which formats the game hands (FSR 4 on Vulkan will take RGBA16F / R11G11B10F / E5B9G9R9 colour only)
+            h.formatsLogged = true;
+            auto fmt = [&](const char* key) -> int
+            {
+                NVSDK_NGX_Resource_VK* r = nullptr;
+                InParameters->Get(key, (void**) &r);
+                return r != nullptr ? (int) r->Resource.ImageViewInfo.Format : -1;
+            };
+            LOG_INFO("Vela VK: handle {0} ({1} {2}x{3} -> {4}x{5}): colour VkFormat {6}, depth {7}, motion vectors {8}, "
+                     "output {9} (-1 = not given)",
+                     handleId, feature->Name(), feature->RenderWidth(), feature->RenderHeight(),
+                     feature->DisplayWidth(), feature->DisplayHeight(), fmt(NVSDK_NGX_Parameter_Color),
+                     fmt(NVSDK_NGX_Parameter_Depth), fmt(NVSDK_NGX_Parameter_MotionVectors),
+                     fmt(NVSDK_NGX_Parameter_Output));
+        }
+        bool change = false;
+        if (seen && h.model != m)
+        {
+            h.tries = 0;
+            // the panel changed the model: fsr3 <-> dittosr need a re-create on the same backend
+            change = true;
+        }
+        else if (feature->GetUpscalerType() != want && h.tries < 2 && (m != VelaLive::Model::Unset || seen))
+            change = true; // a new handle, or a backend change that did not take yet
+        h.model = m;
+        if (change && m == VelaLive::Model::Unset && feature->GetUpscalerType() == want)
+            change = false; // the live file went away and the handle already runs the ini's upscaler
+        if (change)
+        {
+            h.tries++;
+            // SGSR 2 is made for one render size: the new one takes the size the game draws now (its subrect)
+            unsigned int sw = 0, sh = 0;
+            InParameters->Get(NVSDK_NGX_Parameter_DLSS_Render_Subrect_Dimensions_Width, &sw);
+            InParameters->Get(NVSDK_NGX_Parameter_DLSS_Render_Subrect_Dimensions_Height, &sh);
+            VelaLive::SubW = sw;
+            VelaLive::SubH = sh;
+            LOG_INFO("Vela live: handle {0} model {1} -> {2} (the game draws {3}x{4}, Vulkan)", handleId,
+                     VelaLive::ModelName(m), UpscalerDisplayName(want), sw, sh);
+            state.newBackend = want;
+            state.changeBackend[handleId] = true;
+        }
+    }
+
+    // Vela 0040: the game keeps its DLSS feature and draws another subrect (dynamic resolution, the panel's ratio). SGSR 2
+    // is made for one render size: re-created at the subrect once that size held for 30 frames (as in DX12)
+    if (contextData->feature != nullptr && !state.changeBackend[handleId] &&
+        contextData->feature->GetUpscalerType() == Upscaler::SGSR2)
+    {
+        auto* feature = contextData->feature.get();
+        struct VelaSubVk
+        {
+            unsigned int w = 0, h = 0, held = 0;
+        };
+        static ankerl::unordered_dense::map<unsigned int, VelaSubVk> velaSubs;
+        auto& vs = velaSubs[handleId];
+        unsigned int sw = 0, sh = 0;
+        if (InParameters->Get(NVSDK_NGX_Parameter_DLSS_Render_Subrect_Dimensions_Width, &sw) ==
+                NVSDK_NGX_Result_Success &&
+            InParameters->Get(NVSDK_NGX_Parameter_DLSS_Render_Subrect_Dimensions_Height, &sh) ==
+                NVSDK_NGX_Result_Success &&
+            sw > 0 && sh > 0 && (sw != feature->RenderWidth() || sh != feature->RenderHeight()))
+        {
+            vs.held = (sw == vs.w && sh == vs.h) ? vs.held + 1 : 0;
+            vs.w = sw;
+            vs.h = sh;
+            if (vs.held == 30)
+            {
+                LOG_INFO("Vela live: the game draws {0}x{1}, {2} made for {3}x{4}: re-created", sw, sh, feature->Name(),
+                         feature->RenderWidth(), feature->RenderHeight());
+                VelaLive::SubW = sw;
+                VelaLive::SubH = sh;
+                state.newBackend = feature->GetUpscalerType();
+                state.changeBackend[handleId] = true;
+            }
+        }
+        else
+            vs.held = 0;
+    }
+
     if (state.changeBackend[handleId])
     {
         auto successfulPhase =
diff --git a/OptiScaler/proxies/FfxApi_Proxy.h b/OptiScaler/proxies/FfxApi_Proxy.h
index fce0fcc..b8ea91f 100644
--- a/OptiScaler/proxies/FfxApi_Proxy.h
+++ b/OptiScaler/proxies/FfxApi_Proxy.h
@@ -98,6 +98,10 @@ class FfxApiProxy
     inline static bool dittosrRoute = false;
     inline static std::string dittosrWhy;
     inline static ankerl::unordered_dense::set<ffxContext> dittosrContexts;
+    // Vela 0040: DittoSR on Vulkan (InitDittoSRVk below; FFXFeature_Vk.cpp calls its exports itself)
+    inline static FfxModule dittosr_vk;
+    inline static bool dittosrVkTried = false;
+    inline static std::string dittosrVkWhy;
 
     static bool IsLoader(const std::wstring& filePath)
     {
@@ -1606,6 +1610,106 @@ class FfxApiProxy
         return dittosr_dx12.CreateContext != nullptr;
     }
 
+    // Vela 0040: DittoSR in a native Vulkan game. DittoSR 0.5.4 is one binary for D3D12 and Vulkan (its release zip's
+    // amd_fidelityfx_dx12.dll and amd_fidelityfx_vk.dll have the same md5; the Vulkan path needs only Vulkan 1.1 core),
+    // so the file Vela ships for DX12 is also the Vulkan provider. Looked for in the same folders as InitDittoSRDx12, first
+    // as amd_fidelityfx_upscaler_vk.dll, then as amd_fidelityfx_upscaler_dx12.dll (neither name is one OptiScaler's load
+    // hooks or AMD's Vulkan module answer to: AMD's is amd_fidelityfx_vk.dll). Loaded once, lazily, never hooked; the
+    // Vulkan feature calls its exports directly (FFXFeature_Vk.cpp), so fsr3 keeps AMD's FSR 3.1 module.
+    static std::wstring DittoSRVk_Path() { return dittosr_vk.filePath; }
+    static const std::string& DittoSRVk_Why() { return dittosrVkWhy; }
+    static PfnFfxCreateContext DittoSRVk_CreateContext() { return dittosr_vk.CreateContext; }
+    static PfnFfxDestroyContext DittoSRVk_DestroyContext() { return dittosr_vk.DestroyContext; }
+    static PfnFfxConfigure DittoSRVk_Configure() { return dittosr_vk.Configure; }
+    static PfnFfxQuery DittoSRVk_Query() { return dittosr_vk.Query; }
+    static PfnFfxDispatch DittoSRVk_Dispatch() { return dittosr_vk.Dispatch; }
+
+    static bool InitDittoSRVk()
+    {
+        if (dittosrVkTried)
+            return dittosr_vk.CreateContext != nullptr;
+        dittosrVkTried = true;
+
+        const std::wstring names[] = { L"amd_fidelityfx_upscaler_vk.dll", L"amd_fidelityfx_upscaler_dx12.dll" };
+        std::vector<std::filesystem::path> dirs;
+        if (const char* e = std::getenv("VELA_DITTOSR_DIR"); e != nullptr && e[0] != 0)
+            dirs.push_back(std::filesystem::path(string_to_wstring(e)));
+        else
+        {
+            wchar_t own[MAX_PATH] {};
+            const DWORD n = GetModuleFileNameW(dllModule, own, MAX_PATH);
+            if (n > 0 && n < MAX_PATH)
+                dirs.push_back(std::filesystem::path(own).parent_path() / L"dittosr");
+            if (Config::Instance()->MainDllPath.has_value())
+            {
+                const auto d = std::filesystem::path(Config::Instance()->MainDllPath.value()) / L"dittosr";
+                if (dirs.empty() || d.lexically_normal() != dirs[0].lexically_normal())
+                    dirs.push_back(d);
+            }
+        }
+
+        std::filesystem::path file;
+        bool found = false;
+        std::error_code ec;
+        for (const auto& d : dirs)
+        {
+            for (const auto& nm : names)
+            {
+                file = (d / nm).make_preferred();
+                if (std::filesystem::exists(file, ec))
+                {
+                    found = true;
+                    break;
+                }
+            }
+            if (found)
+                break;
+        }
+        if (dirs.empty())
+            dittosrVkWhy = "no folder (VELA_DITTOSR_DIR unset and OptiScaler's DLL folder unknown)";
+        else if (!found)
+        {
+            dittosrVkWhy = "no file";
+            file = (dirs[0] / names[0]).make_preferred();
+        }
+        else
+        {
+            dittosr_vk.dll = NtdllProxy::LoadLibraryExW_Ldr(file.c_str(), NULL, 0);
+            if (dittosr_vk.dll == nullptr)
+                dittosrVkWhy = "load failed (error " + std::to_string(GetLastError()) + ")";
+            else if (dittosr_vk.dll == main_vk.dll || dittosr_vk.dll == main_vk_hooked.dll)
+            {
+                dittosrVkWhy = "the loader answered with AMD's Vulkan module already loaded";
+                dittosr_vk.dll = nullptr;
+            }
+            else
+            {
+                auto gpa = KernelBaseProxy::GetProcAddress_();
+                dittosr_vk.Configure = (PfnFfxConfigure) gpa(dittosr_vk.dll, "ffxConfigure");
+                dittosr_vk.CreateContext = (PfnFfxCreateContext) gpa(dittosr_vk.dll, "ffxCreateContext");
+                dittosr_vk.DestroyContext = (PfnFfxDestroyContext) gpa(dittosr_vk.dll, "ffxDestroyContext");
+                dittosr_vk.Dispatch = (PfnFfxDispatch) gpa(dittosr_vk.dll, "ffxDispatch");
+                dittosr_vk.Query = (PfnFfxQuery) gpa(dittosr_vk.dll, "ffxQuery");
+                if (dittosr_vk.Configure == nullptr || dittosr_vk.CreateContext == nullptr ||
+                    dittosr_vk.DestroyContext == nullptr || dittosr_vk.Dispatch == nullptr ||
+                    dittosr_vk.Query == nullptr)
+                {
+                    dittosrVkWhy = "not an FFX API provider (an ffx* export is missing)";
+                    dittosr_vk.CreateContext = nullptr;
+                    dittosr_vk.Query = nullptr;
+                }
+            }
+        }
+
+        dittosr_vk.filePath = file.wstring();
+        if (dittosr_vk.CreateContext != nullptr)
+            LOG_INFO("Vela: DittoSR (Vulkan) loaded from {}", wstring_to_string(dittosr_vk.filePath));
+        else
+            LOG_WARN("Vela: DittoSR (Vulkan) not loaded from {}: {}",
+                     file.empty() ? std::string("-") : wstring_to_string(dittosr_vk.filePath), dittosrVkWhy);
+        return dittosr_vk.CreateContext != nullptr;
+    }
+
     static HMODULE VkModule() { return main_vk.dll; }
     static std::wstring VkModule_Path() { return main_vk.filePath; }
 
diff --git a/OptiScaler/upscalers/ffx/FFXFeature_Vk.cpp b/OptiScaler/upscalers/ffx/FFXFeature_Vk.cpp
