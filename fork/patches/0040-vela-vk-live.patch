             Config::Instance()->FfxUpscalerIndex.set_volatile_value(0);
@@ -176,18 +279,43 @@ bool FFXFeatureVk::InitFFX(const NVSDK_NGX_Parameter* InParameters)
         backendDesc.header.pNext = &ov.header;
 
         LOG_DEBUG("_createContext!");
-        auto ret = FfxApiProxy::VULKAN_CreateContext()(&_context, &_contextDesc.header, NULL);
+        auto create = ditto ? FfxApiProxy::DittoSRVk_CreateContext() : FfxApiProxy::VULKAN_CreateContext();
+        auto ret = create(&_context, &_contextDesc.header, NULL);
 
         if (ret != FFX_API_RETURN_OK)
         {
+            if (ditto)
+            {
+                LOG_WARN("Vela live: dittosr cannot run in this game ({}: _createContext error {}); FSR 3 instead",
+                         wstring_to_string(FfxApiProxy::DittoSRVk_Path()), FfxApiProxy::ReturnCodeToString(ret));
+                _context = nullptr;
+                ditto = false;
+                _ditto = false;
+                if (!amdReady)
+                    return false;
+                continue;
+            }
             LOG_ERROR("_createContext error: {0}", FfxApiProxy::ReturnCodeToString(ret));
             return false;
         }
-    }
 
-    auto version = State::Instance().ffxUpscalerVersionNames[Config::Instance()->FfxUpscalerIndex.value_or_default()];
-    _name = "FSR";
-    parse_version(version);
+        auto version = names[Config::Instance()->FfxUpscalerIndex.value_or_default()];
+        _name = ditto ? "DittoSR" : "FSR";
+        parse_version(version);
+        if (ditto)
