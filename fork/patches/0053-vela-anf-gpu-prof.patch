+                 _cpuN ? _cpuBegin / double(_cpuN) : 0.0, _cpuN ? _cpuRec / double(_cpuN) : 0.0, _cpuN);
+        a = ProfAcc {};
+        _cpuBegin = _cpuRec = 0;
+        _cpuN = 0;
+    }
