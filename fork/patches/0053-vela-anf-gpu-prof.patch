+    // ---- GPU pass timing (OPTI_ANF_PROF=1): 7 timestamps per frame around the passes, read NR-2 frames later
+    //   0 cb start, 1 after transition-in, 2 after pre, 3 after the NPU markers (the WAIT spin), 4 after post, 5 after resample, 6 after transition-out
+    void ProfInit()
+    {
+        const char* e = std::getenv("OPTI_ANF_PROF");
+        _prof = e && e[0] == '1';
+        if (!_prof || _qp)
+            return;
+        VkQueryPoolCreateInfo qi { VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+        qi.queryType = VK_QUERY_TYPE_TIMESTAMP;
+        qi.queryCount = NR * 8;
+        VkPhysicalDeviceProperties pr {};
+        vkGetPhysicalDeviceProperties(_physical, &pr);
+        _tsPeriod = pr.limits.timestampPeriod;
+        if (vkCreateQueryPool(_vk, &qi, nullptr, &_qp) != VK_SUCCESS)
+        {
+            _qp = VK_NULL_HANDLE;
+            _prof = false;
+            LOG_WARN("Vela ANF: GPU timestamp pool failed, profiling off");
+            return;
+        }
+        LOG_INFO("Vela ANF: GPU pass profiling on (timestamp period {} ns)", _tsPeriod);
+    }
+    void ProfBegin(VkCommandBuffer cb)
+    {
+        if (!_qp)
+            return;
+        vkCmdResetQueryPool(cb, _qp, uint32_t(_frames % NR) * 8, 8);
+        Ts(cb, 0);
+    }
+    void Ts(VkCommandBuffer cb, uint32_t k)
+    {
+        if (_qp)
+            vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, _qp, uint32_t(_frames % NR) * 8 + k);
+    }
+    void ProfRead(uint64_t f)
+    {
+        if (!_qp)
+            return;
+        uint64_t r[7 * 2] {};
+        const VkResult rc = vkGetQueryPoolResults(_vk, _qp, uint32_t(f % NR) * 8, 7, sizeof r, r, 16,
+                                                  VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+        if (rc != VK_SUCCESS && rc != VK_NOT_READY)
+            return;
+        for (int i = 0; i < 7; i++)
+            if (!r[i * 2 + 1])
+                return;
+        if (f < 30)
+            return;
+        double d[7] {};
+        for (int i = 1; i < 7; i++)
+            d[i] = r[i * 2] > r[(i - 1) * 2] ? double(r[i * 2] - r[(i - 1) * 2]) * _tsPeriod * 1e-6 : 0.0;
+        const bool up = _profNpu[f % NR];
+        ProfAcc& a = _acc[up ? 1 : 0];
+        for (int i = 1; i < 7; i++)
+            a.sum[i] += d[i];
+        const double tot = r[12] > r[0] ? double(r[12] - r[0]) * _tsPeriod * 1e-6 : 0.0;
+        a.tot += tot;
+        a.waitMax = std::max(a.waitMax, d[3]);
+        ++a.n;
+        if (a.n >= 600)
+            ProfLog(up);
+    }
+    void ProfLog(bool up)
