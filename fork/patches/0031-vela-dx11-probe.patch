+// Vela 0031 (opt-in A/B, NOT a confirmed fix): VELA_DX11_SHARED_BIND=1 makes the bridge's own shared copies with the
+// fewest bind flags (inputs: shader resource only; the output: shader resource + UAV) instead of the game's. Suspect in
+// Ghostrunner DX11 (white / black scene on Turnip): DXVK creates the shared image from its D3D11 bind flags and
+// vkd3d-proton re-creates it from the shared metadata with its own usage / create flags; if the two differ, Turnip can
+// pick different layouts (UBWC on one side only). Fewer bind flags leave both sides fewer ways to differ. Depth-stencil
+// textures keep their flags.
+static void VelaSharedBind(D3D11_TEXTURE2D_DESC& desc, bool copy)
+{
+    static const bool on = []
+    {
+        const char* e = std::getenv("VELA_DX11_SHARED_BIND");
+        const bool v = e != nullptr && e[0] == '1';
+        if (v)
+            LOG_INFO("Vela DX11: shared copies with the fewest bind flags (VELA_DX11_SHARED_BIND=1)");
+        return v;
+    }();
+
+    if (!on || (desc.BindFlags & D3D11_BIND_DEPTH_STENCIL) != 0)
+        return;
+
+    // the output keeps the game's UAV bit (an sRGB output cannot take a new one)
+    desc.BindFlags = copy ? D3D11_BIND_SHADER_RESOURCE
+                          : (D3D11_BIND_SHADER_RESOURCE | (desc.BindFlags & D3D11_BIND_UNORDERED_ACCESS));
+}
