@@ -630,7 +634,18 @@ bool FFXFeatureDx12::InitFFX(const NVSDK_NGX_Parameter* InParameters)
 {
     LOG_FUNC();
 
-    if (!ModuleLoaded())
+    // Vela 0036: live model dittosr -- the context comes from DittoSR's own module (FfxApiProxy::InitDittoSRDx12);
