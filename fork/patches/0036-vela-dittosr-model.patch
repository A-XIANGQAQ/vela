From 10c5da71594cf6015f86e8388ab18fc757fb6200 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 00:12:52 +0100
Subject: [PATCH] 0036-vela-dittosr-model: Vela live model dittosr = DittoSR
 (github.com/Vancete/DittoSR 0.5.4, MIT, an FFX API provider) on the FFX
 backend (DX12 FFX, DX11 FFX_on12); its context comes from a module of its own
 (FfxApiProxy::InitDittoSRDx12: VELA_DITTOSR_DIR or <OptiScaler's DLL
 folder>\dittosr\amd_fidelityfx_upscaler_dx12.dll, loaded once, never hooked),
 so fsr3 keeps AMD's FSR 3.1 and fsr3 <-> dittosr switch live; no file, a
 failed load or create -> FSR 3 with a "cannot run" line

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 OptiScaler/inputs/NVNGX_DLSS_Dx11.cpp        |   5 +-
 OptiScaler/inputs/NVNGX_DLSS_Dx12.cpp        |   2 +-
 OptiScaler/proxies/FfxApi_Proxy.h            | 145 +++++++++++++++++++
 OptiScaler/upscalers/ffx/FFXFeature_Dx12.cpp |  74 +++++++++-
 OptiScaler/upscalers/sgsr3/VelaLive.h        |  16 +-
 5 files changed, 229 insertions(+), 13 deletions(-)

diff --git a/OptiScaler/inputs/NVNGX_DLSS_Dx11.cpp b/OptiScaler/inputs/NVNGX_DLSS_Dx11.cpp
index 27faaff..bceec1c 100644
--- a/OptiScaler/inputs/NVNGX_DLSS_Dx11.cpp
+++ b/OptiScaler/inputs/NVNGX_DLSS_Dx11.cpp
@@ -729,7 +729,8 @@ NVSDK_NGX_API NVSDK_NGX_Result NVSDK_NGX_D3D11_GetFeatureRequirements(
 
 // Vela 0027 (Vela 0.8.23): Vela live in DX11, the same rules as NVNGX_DLSS_Dx12.cpp. The panel's model re-creates the
 // upscaler over the DX11 -> DX12 bridge: fsr4 / fsr4fast -> SGSR 3 (its FSR 4 VK bridge, the NPU path, FSR 4 Fast),
-// fsr3 -> FFX (FSR 3.1 from amd_fidelityfx_dx12.dll, FFXFeature_Dx12.cpp), sgsr2 -> SGSR 2, no file -> the ini's (an
+// fsr3 -> FFX (FSR 3.1 from amd_fidelityfx_dx12.dll, FFXFeature_Dx12.cpp; 0036: dittosr -> the same FFX backend on
+// DittoSR's module), sgsr2 -> SGSR 2, no file -> the ini's (an
 // ini asking for SGSR 3 alone gets SGSR 2). FSR 4 that cannot run here, or a context without depth: SGSR 2. Per handle,
 // at most two tries of a backend per model (three when going down to SGSR 2).
 static void VelaLiveDx11(IFeature_Dx11* feature, unsigned int handleId, NVSDK_NGX_Parameter* InParameters)
@@ -770,7 +771,7 @@ static void VelaLiveDx11(IFeature_Dx11* feature, unsigned int handleId, NVSDK_NG
     const bool noDepth = isFsr4 && !fsr4Down && velaDepth == nullptr;
     const Upscaler iniUp = Config::Instance()->Dx11Upscaler.value_or_default();
     const Upscaler want = m == VelaLive::Model::Sgsr2 || fsr4Down || noDepth ? Upscaler::SGSR2_on12
-                          : m == VelaLive::Model::Fsr3                       ? Upscaler::FFX_on12
+                          : VelaLive::IsFfx(m)                               ? Upscaler::FFX_on12
                           : isFsr4                                           ? Upscaler::SGSR3_on12
                           : iniUp == Upscaler::SGSR3_on12                    ? Upscaler::SGSR2_on12
                                                                              : iniUp;
diff --git a/OptiScaler/inputs/NVNGX_DLSS_Dx12.cpp b/OptiScaler/inputs/NVNGX_DLSS_Dx12.cpp
index 84029a2..2712027 100644
--- a/OptiScaler/inputs/NVNGX_DLSS_Dx12.cpp
+++ b/OptiScaler/inputs/NVNGX_DLSS_Dx12.cpp
@@ -1169,7 +1169,7 @@ static NVSDK_NGX_Result TryEvaluateOptiFeature(ID3D12GraphicsCommandList* InCmdL
         }
         const Upscaler iniUp = cfg.Dx12Upscaler.value_or_default();
         const Upscaler want = m == VelaLive::Model::Sgsr2 || fsr4Down || noDepth ? Upscaler::SGSR2
-                              : m == VelaLive::Model::Fsr3            ? Upscaler::FFX
+                              : VelaLive::IsFfx(m)                    ? Upscaler::FFX  // 0036: and dittosr
                               : isFsr4                                ? Upscaler::SGSR3
                               : iniUp == Upscaler::SGSR3              ? Upscaler::SGSR2
                                                                       : iniUp;
diff --git a/OptiScaler/proxies/FfxApi_Proxy.h b/OptiScaler/proxies/FfxApi_Proxy.h
index e217f10..fce0fcc 100644
--- a/OptiScaler/proxies/FfxApi_Proxy.h
+++ b/OptiScaler/proxies/FfxApi_Proxy.h
@@ -92,6 +92,13 @@ class FfxApiProxy
 
     inline static bool _skipDestroyCalls = false;
 
