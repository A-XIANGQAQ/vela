+
         if (isFg && fg_dx12.dll != nullptr)
         {
             LOG_DEBUG("Creating with fg_dx12");
@@ -1250,6 +1277,14 @@ class FfxApiProxy
         ffxReturnCode_t result = FFX_API_RETURN_ERROR;
