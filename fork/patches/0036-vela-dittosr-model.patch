+            return dittosr_dx12.Configure(context, desc);
+
         auto type = GetType(desc->type);
 
         if (type == FFXStructType::General && contextToType.contains(*context))
@@ -1390,6 +1428,11 @@ class FfxApiProxy
     static ffxReturnCode_t D3D12_Query(ffxContext* context, ffxQueryDescHeader* desc)
     {
         auto type = GetIndirectType(desc);
+
+        // Vela 0036: DittoSR's contexts, and the version query of a DittoRoute
+        if ((context != nullptr && dittosrContexts.contains(*context)) ||
+            (context == nullptr && dittosrRoute && type == FFXStructType::Upscaling && dittosr_dx12.Query != nullptr))
+            return dittosr_dx12.Query(context, desc);
         auto isFg = type == FFXStructType::FG || type == FFXStructType::SwapchainDX12;
 
         if (isFg && fg_dx12.dll != nullptr)
@@ -1426,6 +1469,9 @@ class FfxApiProxy
 
     static ffxReturnCode_t D3D12_Dispatch(ffxContext* context, const ffxDispatchDescHeader* desc)
     {
+        if (context != nullptr && dittosrContexts.contains(*context)) // Vela 0036
+            return dittosr_dx12.Dispatch(context, desc);
+
         auto type = GetType(desc->type);
         auto isFg = type == FFXStructType::FG || type == FFXStructType::SwapchainDX12;
 
@@ -1461,6 +1507,105 @@ class FfxApiProxy
         return FFX_API_RETURN_NO_PROVIDER;
     }
 
+    // ---------------------------------------------------------------- Vela 0036: DittoSR (live model dittosr)
+    // DittoSR (github.com/Vancete/DittoSR, MIT) is an FFX API upscaler provider ("FSR 3.1.5 API"). Its
+    // amd_fidelityfx_dx12.dll, renamed amd_fidelityfx_upscaler_dx12.dll, is a module of its own: loaded once, lazily,
+    // from VELA_DITTOSR_DIR or <folder of OptiScaler's DLL>\dittosr\ (then <MainDllPath>\dittosr\), never the game's or
+    // AMD's SR module and never hooked, so fsr3 keeps AMD's FSR 3.1 and the panel switches fsr3 <-> dittosr in one
+    // session. The contexts it made go back to it (Configure / Query / Dispatch / Destroy above); the create and the
+    // version query go to it while a DittoRoute lives (FFXFeature_Dx12.cpp InitFFX).
+    struct DittoRoute
+    {
+        bool on;
+        explicit DittoRoute(bool o) : on(o)
+        {
+            if (on)
+                dittosrRoute = true;
+        }
+        ~DittoRoute()
+        {
+            if (on)
+                dittosrRoute = false;
+        }
+    };
+
+    static std::wstring DittoSRDx12_Path() { return dittosr_dx12.filePath; }
+    static const std::string& DittoSRDx12_Why() { return dittosrWhy; }
+
+    static bool InitDittoSRDx12()
+    {
+        if (dittosrTried)
+            return dittosr_dx12.CreateContext != nullptr;
+        dittosrTried = true;
+
+        const std::wstring name = L"amd_fidelityfx_upscaler_dx12.dll";
+        std::vector<std::filesystem::path> dirs;
+        if (const char* e = std::getenv("VELA_DITTOSR_DIR"); e != nullptr && e[0] != 0)
+            dirs.push_back(std::filesystem::path(string_to_wstring(e)));
+        else
+        {
+            wchar_t own[MAX_PATH] {};
+            const DWORD n = GetModuleFileNameW(dllModule, own, MAX_PATH);
+            if (n > 0 && n < MAX_PATH)
+                dirs.push_back(std::filesystem::path(own).parent_path() / L"dittosr");
+            if (Config::Instance()->MainDllPath.has_value())
+            {
+                const auto d = std::filesystem::path(Config::Instance()->MainDllPath.value()) / L"dittosr";
+                if (dirs.empty() || d.lexically_normal() != dirs[0].lexically_normal())
+                    dirs.push_back(d);
+            }
+        }
+
+        std::filesystem::path file;
+        std::error_code ec;
+        for (const auto& d : dirs)
+        {
+            file = (d / name).make_preferred();
+            if (std::filesystem::exists(file, ec))
+                break;
+        }
+        if (file.empty())
+            dittosrWhy = "no folder (VELA_DITTOSR_DIR unset and OptiScaler's DLL folder unknown)";
+        else if (!std::filesystem::exists(file, ec))
+            dittosrWhy = "no file";
+        else
+        {
+            dittosr_dx12.dll = NtdllProxy::LoadLibraryExW_Ldr(file.c_str(), NULL, 0);
+            if (dittosr_dx12.dll == nullptr)
+                dittosrWhy = "load failed (error " + std::to_string(GetLastError()) + ")";
+            else if (dittosr_dx12.dll == upscaling_dx12.dll || dittosr_dx12.dll == main_dx12.dll)
+            {
+                dittosrWhy = "the loader answered with the AMD module already loaded";
+                dittosr_dx12.dll = nullptr;
+            }
+            else
+            {
+                auto gpa = KernelBaseProxy::GetProcAddress_();
+                dittosr_dx12.Configure = (PfnFfxConfigure) gpa(dittosr_dx12.dll, "ffxConfigure");
+                dittosr_dx12.CreateContext = (PfnFfxCreateContext) gpa(dittosr_dx12.dll, "ffxCreateContext");
+                dittosr_dx12.DestroyContext = (PfnFfxDestroyContext) gpa(dittosr_dx12.dll, "ffxDestroyContext");
+                dittosr_dx12.Dispatch = (PfnFfxDispatch) gpa(dittosr_dx12.dll, "ffxDispatch");
+                dittosr_dx12.Query = (PfnFfxQuery) gpa(dittosr_dx12.dll, "ffxQuery");
+                if (dittosr_dx12.Configure == nullptr || dittosr_dx12.CreateContext == nullptr ||
+                    dittosr_dx12.DestroyContext == nullptr || dittosr_dx12.Dispatch == nullptr ||
+                    dittosr_dx12.Query == nullptr)
+                {
+                    dittosrWhy = "not an FFX API provider (an ffx* export is missing)";
+                    dittosr_dx12.CreateContext = nullptr;
+                    dittosr_dx12.Query = nullptr;
+                }
+            }
+        }
+
+        dittosr_dx12.filePath = file.wstring();
+        if (dittosr_dx12.CreateContext != nullptr)
+            LOG_INFO("Vela: DittoSR loaded from {}", wstring_to_string(dittosr_dx12.filePath));
+        else
+            LOG_WARN("Vela: DittoSR not loaded from {}: {}",
+                     file.empty() ? std::string("-") : wstring_to_string(dittosr_dx12.filePath), dittosrWhy);
+        return dittosr_dx12.CreateContext != nullptr;
+    }
+
     static HMODULE VkModule() { return main_vk.dll; }
     static std::wstring VkModule_Path() { return main_vk.filePath; }
 
