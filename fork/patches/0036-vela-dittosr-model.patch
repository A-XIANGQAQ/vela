                 {
                     break;
@@ -1187,6 +1204,16 @@ class FfxApiProxy
 
         ffxReturnCode_t result = FFX_API_RETURN_ERROR;
 
+        // Vela 0036: the upscaler context of a DittoRoute goes to DittoSR's module
+        if (dittosrRoute && type == FFXStructType::Upscaling && dittosr_dx12.CreateContext != nullptr)
