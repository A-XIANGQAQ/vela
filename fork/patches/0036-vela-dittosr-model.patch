+                 wstring_to_string(FfxApiProxy::DittoSRDx12_Path()), FfxApiProxy::DittoSRDx12_Why());
+        ditto = false;
+    }
+
+    if (!ditto && !FfxApiProxy::IsSRReady(false))
         return false;
 
     if (IsInited())
@@ -642,17 +657,20 @@ bool FFXFeatureDx12::InitFFX(const NVSDK_NGX_Parameter* InParameters)
         return false;
     }
 
+    for (;;)
     {
         ScopedSkipSpoofingGlobal skipSpoofingGlobal {};
+        FfxApiProxy::DittoRoute dittoRoute(ditto);
 
-        // Vela: the FSR SDK sees an RDNA3 adapter while it picks its model (FSR 4 INT8 forced, not AMD)
+        // Vela: the FSR SDK sees an RDNA3 adapter while it picks its model (FSR 4 INT8 forced, not AMD; not for
+        // DittoSR)
         const auto gpu = IdentifyGpu::getPrimaryGpu();
         struct VelaAmd
         {
             bool on;
             explicit VelaAmd(bool o) : on(o) { if (on) VelaLive::AmdForFfx = true; }
             ~VelaAmd() { if (on) VelaLive::AmdForFfx = false; }
-        } velaAmd(gpu.vendorId != VendorId::AMD && gpu.fsr4Support == FSR4Support::INT8);
+        } velaAmd(!ditto && gpu.vendorId != VendorId::AMD && gpu.fsr4Support == FSR4Support::INT8);
 
         QueryVersionsDx12(Device);
 
@@ -677,9 +695,33 @@ bool FFXFeatureDx12::InitFFX(const NVSDK_NGX_Parameter* InParameters)
             }
         }
 
+        // Vela 0036: dittosr takes DittoSR's upscaler (the version named DittoSR, else its first)
+        if (ditto)
+        {
+            auto& names = State::Instance().ffxUpscalerVersionNames;
+            int pick = names.empty() ? -1 : 0;
+            for (size_t i = 0; i < names.size(); i++)
+                if (names[i] != nullptr && std::string(names[i]).find("DittoSR") != std::string::npos)
+                {
+                    pick = (int) i;
+                    break;
+                }
+            if (pick < 0)
+            {
+                LOG_WARN("Vela live: dittosr cannot run in this game ({}: no upscaler version); FSR 3 instead",
+                         wstring_to_string(FfxApiProxy::DittoSRDx12_Path()));
+                ditto = false;
+                if (!FfxApiProxy::IsSRReady(false))
+                    return false;
+                continue;
+            }
+            Config::Instance()->FfxUpscalerIndex.set_volatile_value(pick);
+            LOG_INFO("Vela: FFX upscaler index {} ({}) for DittoSR", pick, names[pick] != nullptr ? names[pick] : "");
+        }
+
         // Vela live model fsr3 (VelaLive.h): FSR 3.1 -- the newest 3.x upscaler the FidelityFX DLL offers (with FSR 4
-        // INT8 forced the block above would take 4.x)
-        if (VelaLive::Poll().model == VelaLive::Model::Fsr3)
+        // INT8 forced the block above would take 4.x); 0036: also dittosr that could not run
+        else if (VelaLive::IsFfx(velaModel))
         {
             auto& names = State::Instance().ffxUpscalerVersionNames;
             int best3 = -1;
@@ -726,6 +768,16 @@ bool FFXFeatureDx12::InitFFX(const NVSDK_NGX_Parameter* InParameters)
 
             if (ret != FFX_API_RETURN_OK)
             {
+                if (ditto)
+                {
+                    LOG_WARN("Vela live: dittosr cannot run in this game ({}: _createContext error {}); FSR 3 instead",
+                             wstring_to_string(FfxApiProxy::DittoSRDx12_Path()), FfxApiProxy::ReturnCodeToString(ret));
+                    _context = nullptr;
+                    ditto = false;
+                    if (!FfxApiProxy::IsSRReady(false))
+                        return false;
+                    continue;
+                }
                 LOG_ERROR("_createContext error: {0}", FfxApiProxy::ReturnCodeToString(ret));
                 return false;
             }
@@ -733,8 +785,18 @@ bool FFXFeatureDx12::InitFFX(const NVSDK_NGX_Parameter* InParameters)
 
         auto version =
             State::Instance().ffxUpscalerVersionNames[Config::Instance()->FfxUpscalerIndex.value_or_default()];
-        _name = "FSR";
+        _name = ditto ? "DittoSR" : "FSR";
         parse_version(version);
+        if (ditto)
+        {
+            // "DittoSR (FSR 3.1.5 API) 0.5.4" -> "0.5.4"
