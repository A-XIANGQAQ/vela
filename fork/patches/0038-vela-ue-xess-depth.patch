@@ -37,7 +54,7 @@ static bool CreateDLSSContext(xess_context_handle_t handle, ID3D12GraphicsComman
     if (initParams->initFlags & XESS_INIT_FLAG_JITTERED_MV)
         initFlags |= NVSDK_NGX_DLSS_Feature_Flags_MVJittered;
 
-    if ((initParams->initFlags & XESS_INIT_FLAG_HIGH_RES_MV) == 0)
+    if (lowResMVs)
         initFlags |= NVSDK_NGX_DLSS_Feature_Flags_MVLowRes;
 
     if (initParams->initFlags & XESS_INIT_FLAG_EXPOSURE_SCALE_TEXTURE)
@@ -136,6 +153,11 @@ xess_result_t hk_xessD3D12CreateContext(ID3D12Device* pDevice, xess_context_hand
             return XESS_RESULT_ERROR_UNINITIALIZED;
     }
 
+    // 0038: an Unreal game's XeSS plugin sends no depth with display-size motion vectors; find its velocity flattening
+    // for the scene depth (VELA_UE_XESS_DEPTH=0: off)
+    if (State::Instance().gameEngine == GameEngineType::Unreal)
+        XeSSUnreal::Hook();
+
     _d3d12Device = pDevice;
     *phContext = (xess_context_handle_t) ++_handleCounter;
 
@@ -192,12 +214,83 @@ xess_result_t hk_xessD3D12Execute(xess_context_handle_t hContext, ID3D12Graphics
     if (pCommandList == nullptr)
         return XESS_RESULT_ERROR_INVALID_ARGUMENT;
 
-    if (!_contexts.contains(hContext) && !CreateDLSSContext(hContext, pCommandList, pExecParams))
-        return XESS_RESULT_ERROR_UNKNOWN;
+    auto depth = pExecParams->pDepthTexture;
+    auto depthBase = pExecParams->inputDepthBase;
+    auto depthState = D3D12_RESOURCE_STATE_COMMON;
+    auto ueSceneDepth = false;
+
+    // 0038 (upstream 7e94156): only when the game gave no depth. Captured scene depth shares the scene color's view rect
+    if (depth == nullptr && XeSSUnreal::Hooked())
+    {
+        depth = XeSSUnreal::SceneDepth(pCommandList, pExecParams, depthState);
+        depthBase = pExecParams->inputColorBase;
+        ueSceneDepth = depth != nullptr;
+
+        auto& vd = _velaUeDepth[hContext];
+        vd.executes++;
+
+        if (ueSceneDepth && !vd.found)
+        {
+            vd.found = true;
+            auto dd = depth->GetDesc();
+            LOG_INFO("Vela depth: XeSS context {0:X} came without depth: the UE scene depth copy ({1}x{2} fmt {3}, from "
+                     "the plugin's velocity flattening) is its depth (VELA_UE_XESS_DEPTH)",
+                     (size_t) hContext, dd.Width, dd.Height, (int) dd.Format);
+        }
+        else if (!ueSceneDepth && vd.found && !vd.lost)
+        {
+            vd.lost = true;
+            LOG_WARN("Vela depth: XeSS context {0:X}: the UE scene depth copy stopped; frames go without depth until it "
+                     "is back",
+                     (size_t) hContext);
+        }
+        else if (ueSceneDepth && vd.lost)
+        {
+            vd.lost = false;
+            LOG_INFO("Vela depth: XeSS context {0:X}: the UE scene depth copy is back", (size_t) hContext);
+        }
+        else if (!vd.found && !vd.notFoundLogged && vd.executes == 120)
+        {
+            vd.notFoundLogged = true;
+            LOG_WARN("Vela depth: XeSS context {0:X} came without depth and no UE scene depth was found in 120 frames: "
+                     "the no-depth path stays",
