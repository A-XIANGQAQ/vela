diff --git a/OptiScaler/hooks/VelaUnityVk.cpp b/OptiScaler/hooks/VelaUnityVk.cpp
new file mode 100644
index 0000000..26e6586
--- /dev/null
+++ b/OptiScaler/hooks/VelaUnityVk.cpp
@@ -0,0 +1,124 @@
+#include <pch.h>
+
+#include "VelaUnityVk.h"
+#include "VelaUnityVkCore.h"
+
+#include <atomic>
+#include <cstdlib>
+#include <cwctype>
+#include <mutex>
+#include <vector>
+
+using namespace vela_unity_vk;
+
+namespace
+{
+constexpr std::wstring_view kPluginName = L"nvunityplugin.dll";
+constexpr std::wstring_view kPluginStem = L"nvunityplugin";
+
+std::mutex g_mx;
+std::vector<HMODULE> g_done; // module handles already looked at (a handful at most)
+std::atomic<bool> g_outside { false };
+
+bool Enabled()
+{
+    static const bool on = []
+    {
+        const char* e = std::getenv("VELA_UNITY_VK_OUTSIDE");
+        return !(e != nullptr && e[0] == '0' && e[1] == 0);
+    }();
+    return on;
+}
+
+bool EndsWithNoCase(std::wstring_view text, std::wstring_view lowerSuffix)
+{
+    if (text.size() < lowerSuffix.size())
+        return false;
+    const size_t off = text.size() - lowerSuffix.size();
+    for (size_t i = 0; i < lowerSuffix.size(); i++)
+        if (static_cast<wchar_t>(std::towlower(text[off + i])) != lowerSuffix[i])
+            return false;
+    // a whole file name: the start of the string or a path separator before it
+    return off == 0 || text[off - 1] == L'\\' || text[off - 1] == L'/';
+}
+
+bool IsPluginName(std::wstring_view name)
+{
+    while (!name.empty() && name.back() == L'\0')
+        name.remove_suffix(1);
+    return EndsWithNoCase(name, kPluginName) || EndsWithNoCase(name, kPluginStem);
+}
+
+// inTime: no code of the module ran yet (called from a load hook, before the loader's caller gets the handle back)
+void Handle(HMODULE module, const char* where, bool inTime)
+{
+    // a data-file / image-resource mapping (low bits set) is not code that will run
+    if (module == nullptr || (reinterpret_cast<uintptr_t>(module) & 3) != 0)
+        return;
+
+    std::scoped_lock lock(g_mx);
+    for (HMODULE m : g_done)
+        if (m == module)
+            return;
+    g_done.push_back(module);
+
+    if (!Enabled())
+    {
+        LOG_INFO("Vela Unity VK: off (VELA_UNITY_VK_OUTSIDE=0): NVUnityPlugin.dll {:X} left as it is ({})",
+                 (size_t) module, where);
+        return;
+    }
+    if (!inTime)
+        LOG_INFO("Vela Unity VK: module already loaded at {} ({:X}); a change now may be too late for this run", where,
+                 (size_t) module);
+
+    uint32_t rva = 0;
+    int hits = 0;
+    switch (Patch(reinterpret_cast<uint8_t*>(module), &rva, &hits))
+    {
+    case PatchResult::Patched:
+        LOG_INFO("Vela Unity VK: patched at RVA {:X} ({}): DLSS plugin events render pass precondition 1 (EnsureInside) "
+                 "-> 2 (EnsureOutside); Evaluate gets a command buffer outside the render pass{}",
+                 rva, where, inTime ? "" : " if the plugin's device init has not run yet");
+        if (inTime)
+            g_outside.store(true);
+        break;
+    case PatchResult::AlreadyOutside:
+        LOG_INFO("Vela Unity VK: already outside at RVA {:X} ({}): nothing to change", rva, where);
+        g_outside.store(true);
+        break;
+    case PatchResult::NotFound:
+        LOG_WARN("Vela Unity VK: not found ({}): no ConfigureEvent signature in NVUnityPlugin.dll {:X}, nothing changed "
+                 "(another plugin build)",
+                 where, (size_t) module);
+        break;
+    case PatchResult::Several:
+        LOG_WARN("Vela Unity VK: several hits ({} in NVUnityPlugin.dll {:X}, {}): nothing changed", hits,
+                 (size_t) module, where);
+        break;
+    case PatchResult::ProtectFailed:
+        LOG_ERROR("Vela Unity VK: VirtualProtect failed at RVA {:X} ({}), error {}: nothing changed", rva, where,
+                  (int) GetLastError());
+        break;
+    case PatchResult::NotAnImage:
+        LOG_WARN("Vela Unity VK: {:X} is not an x64 image ({}): nothing changed", (size_t) module, where);
+        break;
+    }
+}
+} // namespace
+
+HMODULE VelaUnityVk::AfterLoad(std::wstring_view name, HMODULE module, const char* where)
+{
+    if (module != nullptr && IsPluginName(name))
+        Handle(module, where, true);
+    return module;
+}
+
+void VelaUnityVk::CheckLoaded(const char* where)
+{
+    HMODULE module = GetModuleHandleW(L"NVUnityPlugin.dll");
+    if (module != nullptr)
+        Handle(module, where, false);
+}
+
+bool VelaUnityVk::OutsidePass() { return g_outside.load(std::memory_order_relaxed); }
diff --git a/OptiScaler/hooks/VelaUnityVk.h b/OptiScaler/hooks/VelaUnityVk.h
new file mode 100644
index 0000000..9eb6d12
--- /dev/null
+++ b/OptiScaler/hooks/VelaUnityVk.h
@@ -0,0 +1,29 @@
+#pragma once
+
+// Vela 0044 (unity-vk-outside-pass): Unity's NVIDIA plugin (NVUnityPlugin.dll) asks Unity to call its DLSS events
+// INSIDE a render pass (IUnityGraphicsVulkan::ConfigureEvent, renderPassPrecondition = 1). In process, right after the
+// module is loaded and before any of its code ran, that one immediate becomes 2 (EnsureOutside): Evaluate then gets a
+// command buffer outside any render pass and the upscale records into it, in the same frame (no 0043 deferral).
+// The scan and the change: hooks/VelaUnityVkCore.h.
+//
+//   VELA_UNITY_VK_OUTSIDE   0 = off; unset / 1 = on
+//
+// Log lines start with "Vela Unity VK:".
+
+#include <pch.h>
+
+#include <string_view>
+
+namespace VelaUnityVk
+{
+// After a library load returned (the LdrLoadDll and LoadLibrary* hooks). Returns `module` unchanged.
+HMODULE AfterLoad(std::wstring_view name, HMODULE module, const char* where);
+
+// The module may be loaded already (OptiScaler came later): at OptiScaler init and at NVSDK_NGX_VULKAN_Init.
+void CheckLoaded(const char* where);
+
+// True when the plugin will configure (or already had) EnsureOutside before its device init ran: changed from a load
+// hook, or found already "outside". A change made to a module that was already loaded may be too late for this run
+// (the precondition is read once, at the plugin's device init) and does not count.
+bool OutsidePass();
+} // namespace VelaUnityVk
diff --git a/OptiScaler/hooks/VelaUnityVkCore.h b/OptiScaler/hooks/VelaUnityVkCore.h
new file mode 100644
index 0000000..23ea56b
--- /dev/null
+++ b/OptiScaler/hooks/VelaUnityVkCore.h
@@ -0,0 +1,143 @@
+#pragma once
+
+// Vela 0044 (unity-vk-outside-pass): the scan and the one-byte change, free of OptiScaler headers so the same code runs
+// in the host-side test (arm64ec/tests/unity_vk_patch_test.cpp) against the real NVUnityPlugin.dll.
+//
+// NVUnityPlugin.dll (UnityEngine.NVIDIAModule's native half) configures its DLSS plugin events in its Vulkan device init
+// with UnityVulkanPluginEventConfig { renderPassPrecondition = 1, graphicsQueueAccess = 0, flags = 9 }:
+//     C7 44 24 30 01 00 00 00    mov dword ptr [rsp+30h], 1    ; kUnityVulkanRenderPass_EnsureInside
+//     C7 44 24 34 00 00 00 00    mov dword ptr [rsp+34h], 0
+//     C7 44 24 38 09 00 00 00    mov dword ptr [rsp+38h], 9
+// so Unity calls NGX Evaluate inside a render pass, where a compute upscaler cannot record (AUDIT/r8/unity/UNITY_SIDE.md).
+// With the first immediate = 2 (kUnityVulkanRenderPass_EnsureOutside) Unity ends the pass before the event: device job
+// R8B, the same byte changed in the file: the 3D scene is back, no render-pass VUIDs, the upscale in the same frame.
+
+#include <windows.h>
+
+#include <cstdint>
+#include <cstring>
+
+namespace vela_unity_vk
+{
+constexpr size_t kSigSize = 24;
+constexpr size_t kSigValueOffset = 4; // the byte that is 1 (inside) or 2 (outside)
+constexpr uint8_t kInside = 0x01;
+constexpr uint8_t kOutside = 0x02;
+
+inline bool MatchAt(const uint8_t* p, uint8_t value)
+{
+    static const uint8_t sig[kSigSize] = { 0xC7, 0x44, 0x24, 0x30, 0x00, 0x00, 0x00, 0x00, 0xC7, 0x44, 0x24, 0x34,
+                                           0x00, 0x00, 0x00, 0x00, 0xC7, 0x44, 0x24, 0x38, 0x09, 0x00, 0x00, 0x00 };
+    if (p[kSigValueOffset] != value)
+        return false;
+    return std::memcmp(p, sig, kSigValueOffset) == 0 &&
+           std::memcmp(p + kSigValueOffset + 1, sig + kSigValueOffset + 1, kSigSize - kSigValueOffset - 1) == 0;
+}
+
+// hits of the signature with `value` in [p, p + size); *first = the first hit
+inline int CountInRange(const uint8_t* p, size_t size, uint8_t value, const uint8_t** first)
+{
+    int hits = 0;
+    if (p == nullptr || size < kSigSize)
+        return 0;
+    for (size_t i = 0; i + kSigSize <= size; i++)
+    {
+        if (p[i] != 0xC7 || !MatchAt(p + i, value))
+            continue;
+        if (hits++ == 0 && first != nullptr)
+            *first = p + i;
+    }
+    return hits;
+}
+
+struct ScanResult
+{
+    bool validImage = false;
+    int inside = 0;  // hits with value 1
+    int outside = 0; // hits with value 2
+    uint8_t* at = nullptr; // the single hit (inside, else outside)
+    uint32_t rva = 0; // of the value byte (signature start + 4), the address a file patch names
+};
+
+// Walks the executable sections of a module mapped as an image (a loaded DLL).
+inline ScanResult Scan(uint8_t* base)
+{
+    ScanResult r {};
+    if (base == nullptr)
+        return r;
+    const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
+    if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew <= 0 || dos->e_lfanew > 0x1000)
+        return r;
+    const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(base + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE || nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC)
+        return r;
+    r.validImage = true;
+
+    const uint32_t imageSize = nt->OptionalHeader.SizeOfImage;
+    const IMAGE_SECTION_HEADER* sec = IMAGE_FIRST_SECTION(nt);
+    const uint8_t* firstInside = nullptr;
+    const uint8_t* firstOutside = nullptr;
+    for (unsigned i = 0; i < nt->FileHeader.NumberOfSections; i++, sec++)
+    {
+        if ((sec->Characteristics & (IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_CNT_CODE)) == 0)
+            continue;
+        const uint32_t va = sec->VirtualAddress;
+        uint32_t size = sec->Misc.VirtualSize != 0 ? sec->Misc.VirtualSize : sec->SizeOfRawData;
+        if (va >= imageSize)
+            continue;
+        if (size > imageSize - va)
+            size = imageSize - va;
+        const uint8_t* f = nullptr;
+        const int in = CountInRange(base + va, size, kInside, &f);
+        if (in > 0 && firstInside == nullptr)
+            firstInside = f;
+        r.inside += in;
+        const int out = CountInRange(base + va, size, kOutside, &f);
+        if (out > 0 && firstOutside == nullptr)
+            firstOutside = f;
+        r.outside += out;
+    }
+    const uint8_t* at = r.inside > 0 ? firstInside : firstOutside;
+    if (at != nullptr)
+    {
+        r.at = const_cast<uint8_t*>(at);
+        r.rva = static_cast<uint32_t>(at - base + kSigValueOffset);
+    }
+    return r;
+}
+
+enum class PatchResult
+{
+    Patched,        // exactly one "inside" site: now "outside"
+    AlreadyOutside, // no "inside" site, exactly one "outside" site
+    NotFound,
+    Several, // more than one candidate: nothing changed
+    ProtectFailed,
+    NotAnImage
+};
+
+inline PatchResult Patch(uint8_t* base, uint32_t* rva, int* hits)
+{
+    const ScanResult s = Scan(base);
+    if (rva != nullptr)
+        *rva = s.rva;
+    if (hits != nullptr)
+        *hits = s.inside + s.outside;
+    if (!s.validImage)
+        return PatchResult::NotAnImage;
+    if (s.inside + s.outside > 1)
+        return PatchResult::Several;
+    if (s.inside == 0)
+        return s.outside == 1 ? PatchResult::AlreadyOutside : PatchResult::NotFound;
+
+    uint8_t* target = s.at + kSigValueOffset;
+    DWORD old = 0;
+    if (!VirtualProtect(target, 1, PAGE_EXECUTE_READWRITE, &old))
+        return PatchResult::ProtectFailed;
+    *target = kOutside;
+    DWORD ignored = 0;
+    VirtualProtect(target, 1, old, &ignored);
+    FlushInstructionCache(GetCurrentProcess(), s.at, kSigSize);
+    return PatchResult::Patched;
+}
+} // namespace vela_unity_vk
