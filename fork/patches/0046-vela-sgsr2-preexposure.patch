From d43c7df48b8e583b2b02d8f8bd400da8c1e084bb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 24 Nov 2026 03:56:11 +0100
Subject: [PATCH] 0046-vela-sgsr2-preexposure: SGSR 2 (D3D12, D3D11 over D3D12,
 Vulkan: one shared UpdateSharedConstants) hands its shaders previous /
 current pre-exposure, as SGSR 2 defines the uniform (sgsr/v2/README.md; the
 UE plugin SGSRTU.cpp passes View.PrevViewInfo.SceneColorPreExposure /
 View.PreExposure), 1 while the exposure is steady, clamped to 0.25..4, 1 on a
 reset. Until now the game's absolute NGX pre-exposure went in, and the
 shaders use that value as the knee of their reversible tonemap y = x /
 (max(x) + E): games that report 0.2-0.35 (Haste Demo 0.35, Ghostrunner 0.25,
 Into the Dead 0.2) got a knee far below their colour values and a darker
 picture, a game that reports 8 (Manor Lords) a knee that leaves dark colours
 a handful of the 2047 luma steps. Haste Demo menu, same frame: luma 67.1 ->
 69.2 (no upscaler 74.9; the rest is highlight energy the temporal
 accumulation removes, AUDIT/r9/NOTES.md). The game's value stays in the log
 line and in the dumper's metadata. Test switch VELA_SGSR2_PREEXP=abs = the
 old behaviour

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 OptiScaler/upscalers/sgsr2/SGSR2Feature.cpp   | 34 +++++++++++++++++--
 OptiScaler/upscalers/sgsr2/SGSR2Feature.h     |  5 +++
 .../upscalers/sgsr2/SGSR2Feature_Dx12.cpp     |  2 +-
 3 files changed, 38 insertions(+), 3 deletions(-)

diff --git a/OptiScaler/upscalers/sgsr2/SGSR2Feature.cpp b/OptiScaler/upscalers/sgsr2/SGSR2Feature.cpp
index 73dbb3e..3fa44a7 100644
--- a/OptiScaler/upscalers/sgsr2/SGSR2Feature.cpp
+++ b/OptiScaler/upscalers/sgsr2/SGSR2Feature.cpp
@@ -5,7 +5,9 @@
 #include <Util.h>
 #include <MathUtils.h>
 
+#include <algorithm>
 #include <cmath>
+#include <cstring>
 #include <cstdlib>
 
 // Everything the two backends agree on. Only the upload differs between them --
@@ -104,7 +106,9 @@ bool SGSR2Feature::UpdateSharedConstants(NVSDK_NGX_Parameter* InParameters)
     if (InParameters->Get(NVSDK_NGX_Parameter_DLSS_Pre_Exposure, &exposure) != NVSDK_NGX_Result_Success ||
         exposure == 0.0f)
         exposure = 1.0f;
-    _constants.preExposure = exposure;
+    // Vela 0046: the game's value is kept apart; the shader constant is set below, once the reset flag is known.
+    _gamePreExposure = exposure;
+    _constants.preExposure = 1.0f;
 
     // Logged here rather than with the MV line above: preExposure is only
     // settled on the line before this, so reporting it earlier printed the
@@ -112,7 +116,7 @@ bool SGSR2Feature::UpdateSharedConstants(NVSDK_NGX_Parameter* InParameters)
     // black-output bug that is not there.
     if (_frameCount == 0)
         LOG_INFO("  flags: DepthInverted={0} JitteredMV={1} LowResMV={2} AutoExposure={3} preExposure={4}",
-                 DepthInverted(), JitteredMV(), LowResMV(), AutoExposure(), _constants.preExposure);
+                 DepthInverted(), JitteredMV(), LowResMV(), AutoExposure(), _gamePreExposure);
 
     // DLSS carries neither FOV nor the near plane, so OptiScaler exposes its own
     // keys for games that can supply them and falls back to the same user config
@@ -155,6 +159,32 @@ bool SGSR2Feature::UpdateSharedConstants(NVSDK_NGX_Parameter* InParameters)
     // 0024c: no log line here (D3D12 never runs SGSR 2 without depth now; the Vulkan path's own no-depth warning says history off)
     _constants.reset = (reset != 0 || !_historyValid || noDepthNoHistory) ? 1u : 0u;
 
+    // Vela 0046: what the shaders call preExposure is the knee of their reversible tonemap, y = x / (max(x) + E), and
+    // SGSR 2 defines it as <previous pre-exposure> / <current pre-exposure> (sgsr/v2/README.md, uniform table; the UE
+    // plugin SGSRTU.cpp passes View.PrevViewInfo.SceneColorPreExposure / View.PreExposure to the upscale pass): 1 while
+    // the exposure is steady. Until 0045 the game's absolute pre-exposure went in. A game that reports 0.2-0.35
+    // (Haste Demo, Ghostrunner, Into the Dead) got a knee far below its colour values: every filter in that space
+    // (the upscale kernel, the history blend, the 11-bit packing) then leans to the darker sample, and the picture
+    // came out about 10 % darker (Haste Demo menu: luma 67 against 75 without an upscaler). A game that reports 8
+    // (Manor Lords) got a knee so high that dark colours used a handful of the 2047 steps.
+    // Test switch VELA_SGSR2_PREEXP=abs = the old behaviour.
+    {
+        static int absMode = -1;
+        if (absMode < 0)
+        {
+            char v[8] = {};
+            const DWORD n = GetEnvironmentVariableA("VELA_SGSR2_PREEXP", v, sizeof(v));
+            absMode = (n == 3 && strcmp(v, "abs") == 0) ? 1 : 0;
+            LOG_INFO("Vela SGSR 2: shader preExposure = {}", absMode ? "the game's absolute value (VELA_SGSR2_PREEXP=abs, as before 0046)"
+                                                                    : "previous / current pre-exposure (0046)");
+        }
+        float ratio = 1.0f;
+        if (_constants.reset == 0u && _prevGamePreExposure > 0.0f)
+            ratio = std::clamp(_prevGamePreExposure / _gamePreExposure, 0.25f, 4.0f);
+        _prevGamePreExposure = _gamePreExposure;
+        _constants.preExposure = absMode ? _gamePreExposure : ratio;
+    }
+
 
     return true;
 }
diff --git a/OptiScaler/upscalers/sgsr2/SGSR2Feature.h b/OptiScaler/upscalers/sgsr2/SGSR2Feature.h
index 145f60c..71aa55f 100644
--- a/OptiScaler/upscalers/sgsr2/SGSR2Feature.h
+++ b/OptiScaler/upscalers/sgsr2/SGSR2Feature.h
@@ -73,6 +73,11 @@ class SGSR2Feature : public virtual IFeature
     bool _historyValid = false;
     bool _loggedNoHistory = false; // 0024: the no-depth history-off line, once
 
+    // Vela 0046: the pre-exposure the game reports (NGX DLSS_Pre_Exposure) and the one of the frame before. The
+    // shader constant preExposure is NOT this value: see UpdateSharedConstants.
+    float _gamePreExposure = 1.0f;
+    float _prevGamePreExposure = 0.0f;
+
     // Fills _constants from the NGX parameters. API-independent; each backend
     // uploads the result itself.
     bool UpdateSharedConstants(NVSDK_NGX_Parameter* InParameters);
diff --git a/OptiScaler/upscalers/sgsr2/SGSR2Feature_Dx12.cpp b/OptiScaler/upscalers/sgsr2/SGSR2Feature_Dx12.cpp
index c09cbd9..dcd8492 100644
--- a/OptiScaler/upscalers/sgsr2/SGSR2Feature_Dx12.cpp
+++ b/OptiScaler/upscalers/sgsr2/SGSR2Feature_Dx12.cpp
@@ -1084,7 +1084,7 @@ bool SGSR2FeatureDx12::EvaluateInternal(ID3D12GraphicsCommandList* InCommandList
         InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_Y, &dumpMeta.mvScaleY);
         dumpMeta.motionVectorScale[0] = _constants.motionVectorScale[0];
         dumpMeta.motionVectorScale[1] = _constants.motionVectorScale[1];
-        dumpMeta.preExposure = _constants.preExposure;
+        dumpMeta.preExposure = _gamePreExposure; // Vela 0046: the game's value, as before
         dumpMeta.depthInverted = DepthInverted();
         dumpMeta.jitteredMV = JitteredMV();
         dumpMeta.lowResMV = LowResMV();
-- 
