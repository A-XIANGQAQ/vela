diff --git a/OptiScaler/upscalers/sgsr3/Fsr4Feature_Vk.cpp b/OptiScaler/upscalers/sgsr3/Fsr4Feature_Vk.cpp
new file mode 100644
index 0000000..0ed9420
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr3/Fsr4Feature_Vk.cpp
@@ -0,0 +1,143 @@
+#include "pch.h"
+#include "Fsr4Feature_Vk.h"
+#include <Config.h>
+#include <MathUtils.h>
+#include <upscalers/sgsr3/VelaLive.h>
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+
+Fsr4FeatureVk::Fsr4FeatureVk(unsigned int InHandleId, NVSDK_NGX_Parameter* InParameters)
+    : IFeature(InHandleId, InParameters), IFeature_Vk(InHandleId, InParameters)
+{
+    _initParameters = SetInitParameters(InParameters);
+    _moduleLoaded = true;
+}
+
+// one warning that names the reason, then the handles go to SGSR 2 (inputs/NVNGX_DLSS_Vk.cpp) until the model changes
+bool Fsr4FeatureVk::Refuse(const char* why)
+{
+    if (!_refused)
+        LOG_WARN("Vela FSR 4 (Vulkan): not available here: {}; SGSR 2 instead", why);
+    _refused = true;
+    VelaLive::Fsr4Failed() = true;
+    return false;
+}
+
+bool Fsr4FeatureVk::InitInternal(VkCommandBuffer InCmdBuffer, NVSDK_NGX_Parameter* InParameters)
+{
+    if (IsInited())
+        return true;
+    // 1. the switch
+    const char* sw = std::getenv("VELA_VK_FSR4");
+    if (sw == nullptr || std::strcmp(sw, "1") != 0)
+        return Refuse("VELA_VK_FSR4 is not 1");
+    // 2. the handshake: layer build 17+ made this device with the FSR 4 set (winevulkan hands out a thunk for every function
+    // name, so without the mark a provider call would end in a null host pointer)
+    VkPhysicalDeviceDriverProperties dp { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES };
+    VkPhysicalDeviceProperties2 p2 { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2 };
+    p2.pNext = &dp;
+    vkGetPhysicalDeviceProperties2(PhysicalDevice, &p2);
+    if (std::strstr(dp.driverInfo, "fsr4dev") == nullptr)
+    {
+        LOG_INFO("Vela FSR 4 (Vulkan): driverInfo '{}' has no fsr4dev mark", dp.driverInfo);
+        return Refuse("the layer did not make this device with the FSR 4 set (VK_LAYER_VELA_npu build 17 with VELA_VK_FSR4=1)");
+    }
+    // 3. depth
+    if (!DepthInverted())
+        return Refuse("the game's depth is not inverted (v1 has no Vulkan depth flip)");
+    const VelaLive::Model m = VelaLive::Poll().model;
+    const bool lite = m == VelaLive::Model::Fsr4Lite;
+    if (lite && (RenderWidth() < 645 || RenderHeight() < 360 || RenderWidth() > 1920 || RenderHeight() > 1080 ||
+                 TargetWidth() != 1920 || TargetHeight() != 1080))
+    {
+        if (VelaLive::St().cur.npu != 0)
+        {
+            LOG_INFO("Vela NPU: fallback size, GPU path");
+            Fsr4VkCore::NpuShown() = true;
+        }
+        return Refuse("FSR 4.1 Lite runs only from 645x360 to 1920x1080 render -> 1920x1080");
+    }
+    // 4. the provider
+    if (!_core.Create(Device, PhysicalDevice, RenderWidth(), RenderHeight(), TargetWidth(), TargetHeight(), DepthInverted(),
+                      IsHdr(), LowResMV(), JitteredMV(), lite, (uint32_t) VelaLive::St().cur.lossy,
+                      (uint32_t) VelaLive::St().cur.npu))
+        return Refuse("the provider did not start (log above)");
+    _rw = RenderWidth();
+    _rh = RenderHeight();
+    LOG_INFO("Vela FSR 4 (Vulkan): ready, {}x{} -> {}x{}", RenderWidth(), RenderHeight(), TargetWidth(), TargetHeight());
+    SetInit(true);
+    return true;
+}
+
+bool Fsr4FeatureVk::EvaluateInternal(VkCommandBuffer InCmdBuffer, NVSDK_NGX_Parameter* InParameters)
+{
+    if (!IsInited() || !_core.Ready())
+        return false;
+    NVSDK_NGX_Resource_VK *color = nullptr, *depth = nullptr, *mv = nullptr, *output = nullptr;
+    InParameters->Get(NVSDK_NGX_Parameter_Color, (void**) &color);
+    InParameters->Get(NVSDK_NGX_Parameter_Depth, (void**) &depth);
+    InParameters->Get(NVSDK_NGX_Parameter_MotionVectors, (void**) &mv);
+    InParameters->Get(NVSDK_NGX_Parameter_Output, (void**) &output);
+    if (!color || !depth || !mv || !output)
+    {
+        LOG_ERROR("Vela FSR 4 (Vulkan): missing inputs: color {}, depth {}, mv {}, output {}", color != nullptr,
+                  depth != nullptr, mv != nullptr, output != nullptr);
+        return Refuse("an input is missing");
+    }
+    // the render size must be the context's (no dynamic resolution in v1)
+    unsigned int sw = 0, sh = 0;
+    InParameters->Get(NVSDK_NGX_Parameter_DLSS_Render_Subrect_Dimensions_Width, &sw);
+    InParameters->Get(NVSDK_NGX_Parameter_DLSS_Render_Subrect_Dimensions_Height, &sh);
+    if ((sw != 0 && sw != _rw) || (sh != 0 && sh != _rh))
+        return Refuse("the render subrect differs from the context's render size (dynamic resolution)");
+    Fsr4VkCore::Img in[3], out;
+    auto fill = [](NVSDK_NGX_Resource_VK* r, Fsr4VkCore::Img& i, VkImageLayout layout, bool isDepth)
+    {
+        i.image = r->Resource.ImageViewInfo.Image;
+        i.fmt = r->Resource.ImageViewInfo.Format;
+        i.layout = layout;
+        if (isDepth)
+            Fsr4VkCore::DepthInfo(i);
+    };
+    fill(color, in[0], VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, false);
+    fill(depth, in[1], VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, true);
+    fill(mv, in[2], VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, false);
+    fill(output, out, VK_IMAGE_LAYOUT_GENERAL, false);
+
+    auto& cfg = *Config::Instance();
+    Fsr4VkCore::Frame f;
+    InParameters->Get(NVSDK_NGX_Parameter_Jitter_Offset_X, &f.jitterX);
+    InParameters->Get(NVSDK_NGX_Parameter_Jitter_Offset_Y, &f.jitterY);
+    if (InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_X, &f.mvScaleX) != NVSDK_NGX_Result_Success ||
+        InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_Y, &f.mvScaleY) != NVSDK_NGX_Result_Success)
+        f.mvScaleX = f.mvScaleY = 1.0f;
+    if (InParameters->Get(NVSDK_NGX_Parameter_DLSS_Pre_Exposure, &f.preExposure) != NVSDK_NGX_Result_Success)
+        f.preExposure = 1.0f;
+    int reset = 0;
+    InParameters->Get(NVSDK_NGX_Parameter_Reset, &reset);
+    f.reset = reset != 0;
+    if (InParameters->Get(NVSDK_NGX_Parameter_FrameTimeDeltaInMsec, &f.frameTimeMs) != NVSDK_NGX_Result_Success ||
+        f.frameTimeMs < 1.0f)
+        f.frameTimeMs = 16.6f;
+    f.cameraNear = cfg.FsrCameraNear.value_or_default();
+    f.cameraFar = cfg.FsrCameraFar.value_or_default();
+    if (DepthInverted())
+        std::swap(f.cameraNear, f.cameraFar);
+    f.fovV = cfg.FsrVerticalFov.has_value() ? OptiMath::GetRadiansFromDeg(cfg.FsrVerticalFov.value()) : 1.0472f;
+
+    // layouts: the design assumes inputs SHADER_READ_ONLY_OPTIMAL and the output GENERAL, as the SGSR 2 feature does (risk R3);
+    // no transition is recorded (the game's images are already there)
+    if (!_core.Dispatch(InCmdBuffer, in, out, f, false))
+        return Refuse("a frame failed");
+    return true;
+}
+
+Fsr4FeatureVk::~Fsr4FeatureVk()
+{
+    if (Device == VK_NULL_HANDLE)
+        return;
+    vkDeviceWaitIdle(Device);
+    _core.ReleaseCore(false);
+}
diff --git a/OptiScaler/upscalers/sgsr3/Fsr4Feature_Vk.h b/OptiScaler/upscalers/sgsr3/Fsr4Feature_Vk.h
new file mode 100644
index 0000000..e1d1c45
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr3/Fsr4Feature_Vk.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include "nvsdk_ngx_vk.h"
+#include <upscalers/IFeature_Vk.h>
+
+#include "Fsr4VkCore.h"
+
+// FSR 4 (the provider amd_fidelityfx_upscaler_vk.dll, on the NPU through VK_LAYER_VELA_npu) in a game with its own Vulkan
+// (Unity, Haste Demo): round 11, 0050, design AUDIT/r11/NOTES.md. The device, images and command buffer come from NGX; the
+// provider needs a VkDevice made with its extensions and features, which only the layer can switch on (VELA_VK_FSR4=1, layer
+// build 17), and the layer says so in the driver description ("fsr4dev"). Without that mark the provider is never called.
+class Fsr4FeatureVk : public IFeature_Vk
+{
+  public:
+    Fsr4FeatureVk(unsigned int InHandleId, NVSDK_NGX_Parameter* InParameters);
+    ~Fsr4FeatureVk();
+
+    feature_version Version() override { return feature_version { 4, 1, 1, 0 }; }
+    // the value the D3D12 path uses for FSR 4 (the SGSR 3 feature runs it there)
+    Upscaler GetUpscalerType() const final { return Upscaler::SGSR3; }
+    bool ModuleLoaded() override { return true; }
+
+  protected:
+    bool InitInternal(VkCommandBuffer InCmdBuffer, NVSDK_NGX_Parameter* InParameters) override;
+    bool EvaluateInternal(VkCommandBuffer InCmdBuffer, NVSDK_NGX_Parameter* InParameters) override;
+
+  private:
+    bool Refuse(const char* why);
+    Fsr4VkCore _core;
+    bool _refused = false;
+    unsigned int _rw = 0, _rh = 0;
+};
